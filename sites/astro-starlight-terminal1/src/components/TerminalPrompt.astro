          // precedent): the backlog specifies ONE static frame — the
          // engine's reduce fallback would dump all CMATRIX_CAP lines.
          return [...cmatrixLines(CMATRIX_REDUCE_LINES, CMATRIX_COLS, Math.random).map(frame), summary];
        }
        startStream([...cmatrixLines(CMATRIX_CAP, CMATRIX_COLS, Math.random).map(frame), summary], {
          intervalMs: CMATRIX_TICK_MS,
        });
      },

      // snake — the real work: a playable game in an aria-hidden, in-place-
      // rewritten board (see the Snake section below the streamer). A void
      // handler (the demoHandler shape): commitLine's single freshPrompt is
      // the only prompt emitted — the invariant holds by construction. The
      // controls line prints via ctx.print (announced — one of the game's
      // two announced moments) BEFORE startSnake appends the board, so it
      // lands above. Under reduced motion the game declines with an honest
      // static note (the backlog sanctions decline-or-pause; declining
      // ships no motion to users who opted out).
      snake(_args, ctx) {
        if (prefersReducedMotion()) {
          return [
            {
              // ≤74 chars — the white-space:pre width budget (CHEAT_LINE_WIDTH).
              text: 'snake needs motion — your system prefers reduced, so the game sits out.',
              classes: 'shell-out',
            },
          ];
        }
        ctx.print([{ text: 'snake — arrows/wasd steer · q quits', classes: 'shell-comment' }]);
        startSnake();
      },
    };

    function exitHandler(): Line[] {
      return [{ text: 'There is no escape from the shll.', classes: 'shell-out' }];
    }

    // Shared by vim/vi — two keys, one handler (the exitHandler shape).
    function editorHandler(): Line[] {
      return [
        { text: "you can't exit what you never entered.", classes: 'shell-out' },
        { text: "(':q' works here, though. we're not monsters.)", classes: 'shell-comment' },
      ];
    }

    // Shared by less/more — byte-identical output from either key IS the gag.
    function lessHandler(): Line[] {
      return [{ text: 'less is more. more or less.', classes: 'shell-out' }];
    }

    // Shared by demo/tour — two keys, one handler (change 4vkd). The tour is
    // the tx5p replay engine plus the one thing a bare #play= replay can't
    // carry: a narration layer. The opening line prints IMMEDIATELY via
    // print() rather than a returned Line[] — under reduced motion
    // startSequence resolves the whole tour synchronously inside this call,
    // and returned lines would land AFTER it. The closing CTA block rides
    // the onDone hook (natural completion only). The tour NEVER navigates:
    // it ends on a printed install anchor + a typed invitation — a
    // machine-fired navigation mid-read is the exact hostility REPLAY_DENY
    // exists to prevent, and never navigating is what keeps `demo` itself
    // replayable.
    //
    // Recording note (change 4vkd, accepted + self-healing): the demo's
    // machine commits (`demo` itself, then idea/fab/wt/rk/tu) all pass the
    // replayable predicate in commitLine and land in sessionCommands like
    // any commit, so a post-demo `share` link reads #play=demo,idea,… — a
    // harmless duplication: on replay, `demo` REPLACES the in-flight queue
    // (startSequence stops the previous sequence), so the duplicated tail
    // is dropped. Suppressing machine-commit recording would fork
    // commitLine's single-path semantics for a cosmetic.
    function demoHandler(): void {
      print([DEMO_SCRIPT.opening]);
      startSequence(DEMO_SCRIPT.steps, { gapMs: DEMO_GAP_MS, onDone: printDemoClosing });
    }

    // The demo's closing CTA block — loop summary + the printed clickable
    // install anchor + the type-'install' invitation. printBeforePrompt
    // lands it above the final prompt (one-trailing-prompt by construction);
    // runs only on natural completion (stopReplay clears the hook — an
    // interrupted tour earns no pitch).
    function printDemoClosing(): void {
      for (const ln of DEMO_SCRIPT.closing) printBeforePrompt(ln);
    }

    // The play closing funnel (change jf9k): ONE announced summary line (the
    // o33t one-announced-summary rule — it doubles as the animation's
    // resolution), the real toolNavLine anchors (zero copy duplication with
    // the 37ng cards), and a dim typed invitation. play NEVER navigates and
    // never calls navigateWithBeat — a machine-fired navigation mid-read is
    // the exact hostility REPLAY_DENY exists to prevent, and never
    // navigating is what keeps play replayable (the 4vkd demo precedent).
    // printBeforePrompt lands the block above the live prompt on the onDone
    // path and appends on the synchronous reduced-motion path (the o33t
    // no-live-prompt fallback) — one helper, correct on both paths by
    // construction.
    function printPlayClosing(slug: string, summary: string): void {
      printBeforePrompt({ text: summary, classes: 'shell-out shell-comment' });
      printBeforePrompt(toolNavLine(slug));
      printBeforePrompt({
        text: `# see it for real: type 'cd ${slug}' ⏎`,
        classes: 'shell-out shell-comment',
      });
    }

    // Shared by curl/wget: deny the network honestly, each under its own name.
    function denyNetwork(cmd: string): Line[] {
      return [
        { text: `${cmd}: no network from in here — this site is fully static.`, classes: 'shell-out' },
        { text: '(constitution I: static-first, zero runtime. we take it literally.)', classes: 'shell-comment' },
      ];
    }

    // ── Tool-name cards (change 37ng) ─────────────────────────────────────
    // One nav line serves all seven tools — the six cards' closing line, the
    // shll splash's append, and the degraded fallback: real anchors to the
    // tool's overview/readme/commands pages plus the install guide (the
    // html: true trusted-static-string pattern of man/ls). Display text per
    // the user-approved mock: the overview route shown once, sibling pages
    // by name.
    function toolNavLine(slug: string): Line {
      return {
        text: `docs: <a href="${ROUTE_OVERVIEW(slug)}">/${slug}</a> · <a href="${ROUTE_README(slug)}">readme</a> · <a href="${ROUTE_COMMANDS(slug)}">commands</a>     get it: <a href="${ROUTE_INSTALL}">install</a>`,
        classes: 'shell-out shell-dim',
        html: true,
      };
    }

    // The lib's card line descriptors mapped onto the island's .shell-*
    // classes (the lib owns text/width math, the island owns presentation —
    // the cheatsheet division of labor). All card lines are announced:
    // static meaningful text through the normal print path, no ariaHidden
    // (the cheatsheet/tail precedent for announced content).
    const TOOLCARD_CLASSES: Record<'header' | 'usage' | 'blank' | 'sub' | 'more', string> = {
      header: 'shell-out',
      usage: 'shell-out shell-dim',
      blank: 'shell-out',
      sub: 'shell-out',
      more: 'shell-out shell-dim',
    };

    // Shared handler factory for the six tool keys + the rk/fab alias keys
    // (rk = run-kit's short alias, fab = fab-kit's binary) — aliases dispatch
    // with their primary's slug, so eight keys share one body (the
    // editorHandler/denyNetwork precedent, no drift).
    // The card INFORMS in place: nothing navigates, no timer, no nav beat —
    // navigation stays cd's job (the cuur beat) and `man <tool>` keeps the
    // hand-written SYNOPSIS voice. With a first argument matching one of the
    // doc's commands[].name, prints that ONE padded subcommand line + a dim
    // see-more anchor; an unknown argument (or none) prints the full card.
    // A tool absent from TOOL_HELP (missing/invalid json skipped at build,
    // or a failed payload parse) degrades to SYNOPSIS line + nav line only.
    function toolCardHandler(slug: string): Handler {
      return (args) => {
        // Own-property guard (the o33t idiom): TOOL_HELP crossed a JSON
        // boundary — only own keys may resolve, inherited names must miss.
        const doc = Object.hasOwn(TOOL_HELP, slug) ? TOOL_HELP[slug] : undefined;
        if (doc && args[0]) {
          const sub = findSubcommand(doc, args[0].toLowerCase());
          if (sub) {
            return [
              { text: formatSubcommandLine(sub.name, sub.short), classes: 'shell-out' },
              { text: `see: <a href="${ROUTE_COMMANDS(slug)}">${ROUTE_COMMANDS(slug)}</a>`, classes: 'shell-out shell-dim', html: true },
            ];
          }
          // No match → the full card below: an unrecognized argument still
          // deserves the overview, never a pretend execution or an error.
        }
        const card = doc ? buildToolCard(slug, doc) : [];
        if (card.length === 0) {
          // Graceful degrade: the hand-written synopsis + the nav line.
          return [
            { text: `${slug} — ${SYNOPSIS[slug]}`, classes: 'shell-out' },
            toolNavLine(slug),
          ];
        }
        return [
          ...card.map((ln) => ({ text: ln.text, classes: TOOLCARD_CLASSES[ln.kind] })),
          { text: '', classes: 'shell-out' },
          toolNavLine(slug),
        ];
      };
    }

    // rm -rf / --no-preserve-root — the deluxe (change o33t). Stream one
    // removal line per tool (canonical TOOLS order) plus the visitor's home,
    // announced (the drama IS the content), then WIPE the transcript —
    // preserving the live prompt element in place via
    // session.replaceChildren(liveLine): the exactly-one-trailing-prompt
    // invariant holds, focus and listeners survive, no freshPrompt() needed.
    // After a beat (streamFollowup — cleared by stopStream, so Ctrl-C aborts
    // the whole sequence cleanly at any stage), the resolution prints. The
    // greeting is NOT re-printed: the lost transcript is the consequence and
    // the joke. Under reduced motion the removal lines print at once and the
    // wipe is SKIPPED — a sudden full-screen wipe is exactly the kind of
    // dramatic visual change reduce users opted out of — with a merciful
    // second line instead.
    function rmDeluxe(): void {
      const reduce = prefersReducedMotion();
      // The resolution's first line is shared by the reduced-motion and
      // post-wipe paths — one Line, hoisted so the copy can't drift
      // (change o33t review rework).
      const kidding: Line = { text: 'just kidding. the site is static — nothing was harmed.', classes: 'shell-out' };
      startStream(
        [
          ...TOOLS.map((t) => ({ text: `removing /${t}`, classes: 'shell-out' })),
          { text: 'removing /home/visitor', classes: 'shell-out' },
        ],
        {
          intervalMs: RM_TICK_MS,
          onDone: () => {
            if (reduce) {
              printBeforePrompt(kidding);
              printBeforePrompt({ text: '(transcript spared. reduced motion is mercy.)', classes: 'shell-comment' });
              return;
            }
            const liveLine = input.closest<HTMLElement>('[data-terminal-prompt]');
            // replaceChildren detaches the live line before reinserting it,
            // and detaching a focused element blurs it (DOM focus fixup) —
            // so restore focus across the wipe, but ONLY if the input held
            // it beforehand: the no-autofocus principle stands (a chip-tap
            // deluxe never focused the prompt and must stay that way).
            // caretToEnd() re-places the caret a blur would otherwise reset
            // (change o33t review rework).
            const hadFocus = document.activeElement === input;
            if (liveLine) session!.replaceChildren(liveLine);
            if (hadFocus) {
              input.focus();
              caretToEnd();
            }
            streamFollowup = window.setTimeout(() => {
              streamFollowup = undefined;
              printBeforePrompt(kidding);
              printBeforePrompt({ text: '(your session transcript, though? gone. actions have consequences.)', classes: 'shell-comment' });
            }, RM_BEAT_MS);
          },
        },
      );
    }

    // ── Helpers ────────────────────────────────────────────────────────────────
    function isTool(name: string): boolean {
      return (TOOLS as readonly string[]).includes(name);
    }

    function unknownTool(name: string): Line[] {
      return [
        { text: `no such tool: ${name}`, classes: 'shell-out' },
        { text: `tools: ${TOOLS.join('  ')}`, classes: 'shell-out shell-dim' },
      ];
    }

    // `help <arg>` resolution (change cuur): a known command prints its
    // HELP_DETAIL entry; a tool name points sideways to `man` (tools are
    // documented there, not here — `shll` never lands on this branch because
    // its HELP_DETAIL lookup wins first); anything else gets the same
    // did-you-mean suggester the not-found branch uses — one matcher, two
    // call sites, no second fuzzy-match implementation to drift.
    function helpFor(topic: string): Line[] {
      // Own-property guard (change o33t review rework): same prototype-chain
      // hazard as the man bridge — `help constructor` returned an inherited
      // member and crashed print() before the next prompt could be emitted.
      const detail = Object.hasOwn(HELP_DETAIL, topic) ? HELP_DETAIL[topic] : undefined;
      if (detail) return detail;
      if (isTool(topic)) {
        return [{ text: `help: no help for '${topic}' — try 'man ${topic}'`, classes: 'shell-out' }];
      }
      const suggestion = suggestCommand(topic, Object.keys(COMMANDS));
      const tail = suggestion ? ` — did you mean '${suggestion}'?` : '';
      return [{ text: `help: no help for '${topic}'${tail}`, classes: 'shell-out' }];
    }

    // ── Navigation beat (change cuur) ────────────────────────────────────────
    // The pending navigation timer, if any. Held at initTerminal scope so the
    // Ctrl-C branch in onKeydown can cancel it — `^C` + a fresh prompt then
    // read exactly like aborting a command in a real shell, and you stay on
    // the page. Deliberately NOT cleared by commitLine: a new command typed
    // during the beat does not cancel the scheduled navigation (accepted —
    // the beat is short, and the printed line already said where it's headed).
    let pendingNav: number | undefined;

    // Shared by cd/open (tool synopsis first) and install (its single line):
    // print the context lines plus a REAL clickable `opening …` anchor
    // (html: true — our own trusted, static strings only, the same pattern as
    // man/ls), then navigate after NAV_BEAT_MS. The visible beat + cancel
    // hint is what makes the navigation intentional rather than a yank off a
    // playful page; an impatient visitor clicks the anchor through
    // immediately. Chip taps (install, change by18) flow through this same
    // path and inherit the beat. A pure setTimeout — timing, not animation —
    // so there is no prefers-reduced-motion interaction.
    function navigateWithBeat(route: string, lines: Line[]): Line[] {
      pendingNav = window.setTimeout(() => window.location.assign(route), NAV_BEAT_MS);
      return [
        ...lines,
        {
          text: `opening <a href="${route}">${route}</a> … (Ctrl-C to cancel)`,
          classes: 'shell-out shell-dim',
          html: true,
        },
      ];
    }

    function navigateTool(arg: string | undefined): Line[] {
      const tool = (arg ?? '').toLowerCase();
      if (!tool) {
        return [{ text: 'usage: cd <tool>   (try: ls)', classes: 'shell-out' }];
      }
      if (!isTool(tool)) {
        return unknownTool(tool);
      }
      // Context before motion (change cuur): the synopsis line says what
      // you're opening; the beat + anchor give you the choice of when.
      return navigateWithBeat(ROUTE_OVERVIEW(tool), [
        { text: `${tool} — ${SYNOPSIS[tool]}`, classes: 'shell-out' },
      ]);
    }

    // ── Line streamer (change o33t) — the Tier C engine ──────────────────────
    // Emits `lines` one per tick via printBeforePrompt(), so streamed output
    // lands ABOVE the live prompt and the exactly-one-trailing-prompt
    // invariant holds BY CONSTRUCTION (precedent: the Tab ambiguous-match
    // listing). At most one stream at a time — startStream stops any previous
    // one first. The stream is killed by Ctrl-C (the frozen ^C echo + fresh
    // prompt + halted output read exactly like killing a foreground process)
    // and by any newly committed command (commitLine calls stopStream before
    // run — a deliberate contrast with pendingNav, which commitLine does NOT
    // clear: the nav beat is 900ms and already announced its destination,
    // while streams are long-lived and would interleave with new output).
    // Under prefers-reduced-motion there is no interval: all lines print at
    // once and onDone runs immediately (the 23xc ghost-hint precedent —
    // streams are timing, but their visual effect is motion; reduce gets the
    // content without the cadence).
    let activeStream: number | undefined; // interval id
    let streamFollowup: number | undefined; // pending onDone timer (rm-deluxe beat)

    function startStream(lines: Line[], opts: { intervalMs: number; onDone?: () => void }): void {
      stopStream();
      if (lines.length === 0) {
        opts.onDone?.();
        return;
      }
      if (prefersReducedMotion()) {
        for (const ln of lines) printBeforePrompt(ln);
        opts.onDone?.();
        return;
      }
      let next = 0;
      activeStream = window.setInterval(() => {
        printBeforePrompt(lines[next]);
        next += 1;
        if (next >= lines.length) {
          window.clearInterval(activeStream);
          activeStream = undefined;
          opts.onDone?.();
        }
      }, opts.intervalMs);
    }

    function stopStream(): void {
      if (activeStream !== undefined) {
        window.clearInterval(activeStream);
        activeStream = undefined;
      }
      if (streamFollowup !== undefined) {
        window.clearTimeout(streamFollowup);
        streamFollowup = undefined;
      }
    }

    // ── Snake (change kd5e) ──────────────────────────────────────────────────
    // The first input-owning surface beyond streams/replay. A game cannot be
    // append-only, so the board does NOT ride the line streamer: startSnake
    // appends ONE aria-hidden container directly to `session` (the sl-train
    // direct-DOM precedent — run() executes before commitLine's freshPrompt,
    // so the board sits above the live prompt) and each tick rewrites its
    // textContent in place (\n rows under the session's `white-space: pre`;
    // existing .shell-line/.shell-out classes — no new CSS). All game logic
    // is the pure lib (terminal-toys.ts); the island owns only the timer,
    // the DOM writes, and the key wiring. `snakeGame !== undefined` is the
    // game-mode flag onKeydown checks at the top (see handleSnakeKey).
    // Live-region posture: every board rewrite is aria-hidden garbage; the
    // announced moments are the start controls line (the handler), ONE
    // `game over — score: N` per crash, and the quit confirmation.
    let snakeGame: { state: SnakeState; board: HTMLElement; timer: number | undefined } | undefined;

    // Steering map: arrows AND wasd (lowercased e.key). Object.hasOwn-guarded
    // at the lookup (the o33t idiom — keyed by user input).
    const SNAKE_KEY_DIRS: Record<string, SnakeDir> = {
      arrowup: 'up',
      w: 'up',
      arrowdown: 'down',
      s: 'down',
      arrowleft: 'left',
      a: 'left',
      arrowright: 'right',
      d: 'right',
    };
    // Non-printable keys the game swallows besides single chars: everything
    // that would type into the prompt, move focus, or scroll the page.
    // Deliberately NOT F-keys/Escape/etc. — browser chrome stays usable
    // mid-game (swallowing exists to protect the prompt, not to jail the
    // tab).
    const SNAKE_SWALLOW_KEYS = ['tab', 'enter', 'backspace', 'delete', 'pageup', 'pagedown', 'home', 'end'];

    function startSnake(): void {
      const board = document.createElement('span');
      board.className = 'shell-line shell-out';
      board.setAttribute('aria-hidden', 'true');
      session!.appendChild(board);
      snakeGame = { state: snakeInit(SNAKE_COLS, SNAKE_ROWS, Math.random), board, timer: undefined };
      // Clock before first draw: drawSnake reads timer === undefined as
      // the paused state (see pauseSnake), so an unstarted clock would
      // render one frame of 'paused'.
      snakeGame.timer = window.setInterval(snakeTick, SNAKE_TICK_MS);
      drawSnake();
    }

    // One in-place rewrite: lib-rendered board rows + the island's status
    // row, joined with newlines (one block element — scroll position is
    // never touched mid-game).
    function drawSnake(): void {
      if (!snakeGame) return;
      const { state, board, timer } = snakeGame;
      const status = state.over
        ? `  game over — score: ${state.score} · r restarts · q quits`
        : timer === undefined
          ? `  paused — click the terminal to resume · score: ${state.score}`
          : `  score: ${state.score} · arrows/wasd steer · q quits`;
      board.textContent = [...renderSnakeBoard(state), status].join('\n');
    }

    function snakeTick(): void {
      if (!snakeGame || snakeGame.state.over) return;
      snakeGame.state = snakeStep(snakeGame.state, Math.random);
      drawSnake();
      if (snakeGame.state.over) {
        // Freeze: stop the clock but keep the game-mode flag — the over
        // state still owns the keys (r restarts, q releases). The score is
        // announced ONCE here (the o33t one-announced-summary rule);
        // printBeforePrompt lands it between the board and the live prompt.
        window.clearInterval(snakeGame.timer);
        snakeGame.timer = undefined;
        printBeforePrompt({ text: `game over — score: ${snakeGame.state.score}`, classes: 'shell-out' });
      }
    }

    // r/Enter on a game-over board: a fresh game in the SAME container.
    function restartSnake(): void {
      if (!snakeGame) return;
      snakeGame.state = snakeInit(SNAKE_COLS, SNAKE_ROWS, Math.random);
      // Same clock-before-draw order as startSnake (the paused-row read).
      snakeGame.timer = window.setInterval(snakeTick, SNAKE_TICK_MS);
      drawSnake();
    }

    // Focus-scoped capture (see handleSnakeKey) means a blurred input
    // hears no keys — left running, the game would keep moving with the
    // arrows scrolling the page and `q` dead. So blur pauses the clock
    // and refocus resumes it: clicking back in IS the resume gesture
    // (the focus-scoped tradeoff made honest). A game-over board has no
    // clock to pause; timer === undefined doubles as the paused marker
    // drawSnake reads for its status row.
    function pauseSnake(): void {
      if (!snakeGame || snakeGame.timer === undefined) return;
      window.clearInterval(snakeGame.timer);
      snakeGame.timer = undefined;
      drawSnake();
    }

    function resumeSnake(): void {
      if (!snakeGame || snakeGame.state.over || snakeGame.timer !== undefined) return;
      snakeGame.timer = window.setInterval(snakeTick, SNAKE_TICK_MS);
      drawSnake();
    }

    // q / Ctrl-C: release the keys. The frozen board is deliberately LEFT in
    // the transcript (the sl train removes itself; a frozen final board is
    // the better share/screenshot artifact). One announced line confirms the
    // release — without it a sighted-or-not user has no signal that typing
    // works again.
    function quitSnake(): void {
      if (!snakeGame) return;
      const { score } = snakeGame.state;
      teardownSnake();
      printBeforePrompt({ text: `(snake: keys released — final score ${score}.)`, classes: 'shell-comment' });
    }

    // Silent teardown — timer + flag only, board untouched. Called by quit,
    // by commitLine (a by18 chip commit mid-game — the commitLine→stopStream
    // precedent extended to game teardown), and by the game branch's Ctrl-L
    // path (where clear() then removes the board with the transcript).
    function teardownSnake(): void {
      if (!snakeGame) return;
      if (snakeGame.timer !== undefined) window.clearInterval(snakeGame.timer);
      snakeGame = undefined;
    }

    // The game-mode key handler — onKeydown delegates here while snakeGame
    // is set, BEFORE its Ctrl/history/Tab/Enter branches: the game owns the
    // keys until it releases them (the o33t stream-cancel + key-capture
    // discipline extended from "any key kills the replay" to a real input
    // takeover). Returns true when the key is consumed (caller returns);
    // false to fall through (the Ctrl-L teardown path — the normal branch
    // below then clears the transcript and emits its single prompt).
    function handleSnakeKey(e: KeyboardEvent): boolean {
      const plainCtrl = e.ctrlKey && !e.shiftKey && !e.altKey && !e.metaKey;
      const key = e.key.toLowerCase();
      if (plainCtrl && key === 'l') {
        // Tear down, then fall through to the normal Ctrl-L branch: the
        // transcript (frozen board included) clears and exactly one fresh
        // prompt is emitted there — never here.
        teardownSnake();
        return false;
      }
      if (plainCtrl && key === 'c') {
        e.preventDefault();
        quitSnake();
        return true;
      }
      if (e.ctrlKey || e.metaKey || e.altKey) {
        // Other modified combos (Ctrl-Shift-C copy, Cmd-R, …) stay native:
        // consumed past the terminal's branches, but never preventDefault'd
        // — they can't type into the prompt, and jailing browser chrome
        // serves no game purpose.
        return true;
      }
      const dir = Object.hasOwn(SNAKE_KEY_DIRS, key) ? SNAKE_KEY_DIRS[key] : undefined;
      if (dir) {
        // preventDefault is load-bearing: arrows otherwise drive history
        // recall (the branch below) and page scroll.
        e.preventDefault();
        if (snakeGame && !snakeGame.state.over) {
          snakeGame.state = snakeTurn(snakeGame.state, dir);
        }
        return true;
      }
      if (key === 'q') {
        e.preventDefault();
        quitSnake();
        return true;
      }
      if (snakeGame!.state.over && (key === 'r' || key === 'enter')) {
        e.preventDefault();
        restartSnake();
        return true;
      }
      // Everything that would type into the prompt or move the page is
      // swallowed — no typing mid-game. (Enter lands here while playing:
      // no commit, no prompt.)
      if (key.length === 1 || SNAKE_SWALLOW_KEYS.includes(key)) e.preventDefault();
      return true;
    }

    // ── Shareable session helpers (change tx5p) ──────────────────────────────
    // The DOM walk behind `share`: every span.shell-line in DOM order, by
    // textContent — the export mirrors what the EYE sees, so visually-present
    // aria-hidden art rows (the shll splash, the sl train) are included; the
    // SR-noise control they carry is a live-region concern, not a visual one.
    // A LIVE prompt line is excluded (the lib renders it as the bare `$`):
    // the gate is input.isContentEditable, mirroring printBeforePrompt's —
    // during run() the previous input is already frozen, so in practice every
    // line is captured, including the just-echoed `$ share`. The draft text
    // and the ghost-hint span can never leak: the ghost is dismissed before
    // any commit, and a live (draft-carrying) line is excluded here.
    function collectTranscriptLines(): string[] {
      return Array.from(session!.querySelectorAll<HTMLElement>('span.shell-line'))
        .filter((el) => !(input.isContentEditable && el.contains(input)))
        .map((el) => el.textContent ?? '');
    }

    // Clipboard write with a guarded legacy fallback. `share` always runs
    // from a user gesture (Enter or a chip tap), so transient activation is
    // present for the async API; where the API is absent or rejects, the
    // hidden-textarea execCommand('copy') path is tried. Both failing
    // resolves false — the caller prints an honest failure line. Never
    // throws (the sessionStorage try/catch discipline).
    async function copyShareText(text: string): Promise<boolean> {
      if (navigator.clipboard?.writeText) {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {
          // permission denied / not focused — fall through to the legacy path
        }
      }
      return copyViaExecCommand(text);
    }

    function copyViaExecCommand(text: string): boolean {
      // Generic focus capture (review cycle 1): whatever held focus before
      // the copy gets it back after — not only the terminal input. A
      // chip-path share (a focused <button>) must not strand focus on body.
      const prevFocus = document.activeElement;
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.position = 'fixed'; // out of flow — selecting it must not scroll
      ta.style.opacity = '0';
      let ok = false;
      try {
        document.body.appendChild(ta);
        ta.select();
        ok = document.execCommand('copy');
      } catch {
        ok = false;
      } finally {
        // Removal and focus restore must run even when select()/execCommand
        // throws — an invisible focused textarea left in the DOM would
        // swallow every subsequent keystroke.
        ta.remove();
        // select() moved focus to the textarea; ta.remove() drops it to
        // body. Restore the previous holder ONLY when there was one (never
        // initiate focus — the no-autofocus principle stands for chip-tap
        // shares, where body held focus and keeps it).
        if (
          prevFocus instanceof HTMLElement &&
          prevFocus !== document.body &&
          prevFocus.isConnected
        ) {
          prevFocus.focus();
          // The caret needs re-placing only for the contenteditable prompt
          // (a blur resets it) — the rm-deluxe conditional-restore precedent.
          if (prevFocus === input && input.isContentEditable) caretToEnd();
        }
      }
      return ok;
    }

    // ── Deep-link replay (change tx5p; step-generalized by change 4vkd) ──────
    // #play=ls,fortune auto-types and runs a pre-baked command sequence —
    // the loop-closing half of `share`. Each command types into the live
    // input at REPLAY_TYPE_MS (the ghost hint's cadence) and commits via
    // commitLine(false) — the by18 chip path: full commit semantics (history
    // push, stream kill, exitResting, fresh prompt) with NO focus steal; the
    // 23xc no-autofocus decision extends to replay, and page scroll is never
    // touched (the session's internal bottom-pinning after each commit is
    // the normal post-interaction behavior). A replayed command that starts
    // a stream runs it for the gap window; the next command's commitLine
    // kills it — the existing commit-kills-stream contract, no special-casing.
    //
    // Change 4vkd generalizes the queue from bare command strings to
    // ReplayStep ({ narration?, command }): startReplay maps #play= tokens
    // to narration-less steps (byte-identical behavior), while the demo
    // enqueues DEMO_SCRIPT's narrated steps through startSequence — which
    // also carries the per-sequence gap (demo reads slower than replay) and
    // an onDone completion hook (the demo's closing CTA block).
    let replayQueue: ReplayStep[] = [];
    let replayTimer: number | undefined; // pending start-delay / inter-command gap
    let replayTyper: number | undefined; // active per-character typing interval
    let replayGapMs = REPLAY_GAP_MS; // per-sequence inter-step gap (demo: DEMO_GAP_MS)
    let replayOnDone: (() => void) | undefined; // natural-completion hook; stopReplay clears it
    // Sequence epoch (change 4vkd): incremented by every startSequence. A
    // machine-committed command can start its OWN sequence synchronously
    // inside commitLine (`demo`/`tour` — startSequence stops this one and
    // takes over the queue/timers/listener); the outer sequence's post-commit
    // continuation compares the epoch and yields instead of double-scheduling
    // against the new sequence's timers.
    let replayEpoch = 0;

    // The #play= entry point: bare tokens become narration-less steps — the
    // pre-4vkd behavior, byte-identical.
    function startReplay(commands: string[]): void {
      if (commands.length === 0) return;
      startSequence(commands.map((command) => ({ command })));
    }

    // The generalized engine entry (change 4vkd). Options follow the
    // startStream({ intervalMs, onDone? }) shape: gapMs is the inter-step
    // gap (default REPLAY_GAP_MS; the demo passes DEMO_GAP_MS), onDone runs
    // after the last step's commit — on NATURAL completion only (stopReplay
    // clears it: an interrupted tour earns no closing pitch).
    function startSequence(
      steps: ReplayStep[],
      opts: { gapMs?: number; onDone?: () => void } = {},
    ): void {
      if (steps.length === 0) return;
      // Starting a machine sequence REPLACES any in-flight one (the
      // startStream-stops-previous precedent): a replayed `demo`
      // (#play=demo,…) drops the surviving tokens after it — which is also
      // what makes post-demo share links self-healing (see the demo handler).
      stopReplay();
      replayEpoch += 1;
      // Machine interaction is still interaction: the idle ghost hint must
      // not type over a replay. One-shot latch — it never re-arms.
      dismissIdleHint();
      if (prefersReducedMotion()) {
        // No per-character animation, no inter-step gaps, no start delay:
        // print each step's narration, fill the command at once, and commit —
        // the whole sequence (closing block included) resolves synchronously
        // (the streams a replayed command starts already print all-at-once
        // under reduce). Nothing is ever in flight on this path, so the
        // document-level kill listener below is never installed.
        const epoch = replayEpoch;
        const runAll = () => {
          for (const step of steps) {
            // A committed step may have started its own sequence (`demo`) —
            // the epoch bump says it replaced this one; drop what survives.
            if (replayEpoch !== epoch) return;
            for (const n of step.narration ?? []) {
              printBeforePrompt({ text: n, classes: 'shell-out shell-comment' });
            }
            // Focus PRESERVATION, not initiation — the replayNext/rm-deluxe
            // conditional-restore precedent: a typed `demo` reaches here with
            // the input focused (Enter's freshPrompt(true)), and each
            // commit's freezeInput would silently drop that focus to body.
            // At activation (#play= under reduce) nothing holds focus, so
            // this is a no-op there — byte-identical to the pre-4vkd loop.
            const hadFocus = document.activeElement === input;
            input.textContent = step.command;
            commitLine(false);
            if (hadFocus) {
              input.focus();
              caretToEnd();
            }
          }
          if (replayEpoch === epoch) opts.onDone?.();
        };
        if (input.isContentEditable) {
          // Activation path (#play= at load): the live prompt exists — run
          // synchronously, byte-identical to the pre-4vkd reduce loop.
          runAll();
        } else {
          // Started from inside run() (a typed or replayed `demo`): the
          // previous input is frozen and the live prompt doesn't exist until
          // the in-flight commitLine emits it — filling the frozen element
          // would corrupt the just-echoed `$ demo` line. queueMicrotask runs
          // after that commit completes but BEFORE any user event can be
          // processed (events are tasks, not microtasks), so the deferral is
          // user-invisible and nothing is ever observably in flight.
          queueMicrotask(runAll);
        }
        return;
      }
      // The document-level kill listener (review cycle 1 must-fix): replay
      // never focuses the input (R8), so on a #play= load activeElement is
      // body and the input-scoped onKeydown can never fire — without this,
      // NO keystroke (including Ctrl-C) could stop a replay. Installed only
      // while a replay is in flight; stopReplay removes it (zero cost idle).
      // Capture phase: an intermediate handler calling stopPropagation()
      // (e.g. a search dialog) must not be able to swallow the interrupt.
      document.addEventListener('keydown', onReplayKeydown, { capture: true });
      replayGapMs = opts.gapMs ?? REPLAY_GAP_MS;
      replayOnDone = opts.onDone;
      replayQueue = steps.slice();
      replayTimer = window.setTimeout(replayNext, REPLAY_START_DELAY_MS);
    }

    // Any keystroke, anywhere on the page, regardless of focus — which
    // subsumes Ctrl-C — interrupts the replay like a paste-bomb.
    function onReplayKeydown(): void {
      stopReplay();
    }

    function replayNext(): void {
      replayTimer = undefined;
      const step = replayQueue.shift();
      if (step === undefined) {
        // Defensive (normally unreachable — natural completion stops after
        // the last commit): cleanup must be unconditional so the document
        // listener can never be orphaned.
        stopReplay();
        return;
      }
      // Narration first (change 4vkd — demo steps only; #play= steps carry
      // none): dim comment lines above the live prompt, ANNOUNCED (no
      // ariaHidden — the narration IS the story, the `tail` precedent for
      // slow meaningful lines). printBeforePrompt keeps the live prompt the
      // trailing line by construction.
      for (const n of step.narration ?? []) {
        printBeforePrompt({ text: n, classes: 'shell-out shell-comment' });
      }
      const cmd = step.command;
      let typed = 0;
      replayTyper = window.setInterval(() => {
        typed += 1;
        input.textContent = cmd.slice(0, typed);
        if (typed >= cmd.length) {
          window.clearInterval(replayTyper);
          replayTyper = undefined;
          // Focus PRESERVATION, not initiation (R8): the user may have
          // clicked/Tabbed into the input mid-replay; this commit's
          // freezeInput() strips contenteditable from that focused element,
          // so focus would silently fall to body. Capture before, restore
          // onto the fresh prompt after, ONLY in that case (the rm-deluxe
          // conditional-restore precedent at the wipe site) — replay itself
          // never initiates focus, so the 23xc no-autofocus decision holds.
          const hadFocus = document.activeElement === input;
          const epoch = replayEpoch;
          commitLine(false); // reassigns `input` to the fresh prompt's
          if (hadFocus) {
            input.focus();
            caretToEnd();
          }
          // The committed command may have started its OWN machine sequence
          // (`demo`/`tour` call startSequence inside run(), which stops this
          // one and takes over the queue/timers/listener — change 4vkd).
          // Scheduling the next step here would race the new sequence; its
          // epoch bump is the yield signal.
          if (replayEpoch !== epoch) return;
          if (replayQueue.length > 0) {
            replayTimer = window.setTimeout(replayNext, replayGapMs);
          } else {
            // Natural completion — nothing left in flight. stopReplay is the
            // cleanup too (idempotent): here it removes the document-level
            // kill listener and clears the completion hook — so capture the
            // hook first and run it after (the demo's closing CTA block
            // prints on natural completion ONLY; change 4vkd).
            const done = replayOnDone;
            stopReplay();
            done?.();
          }
        }
      }, REPLAY_TYPE_MS);
    }

    // The kill switch — a replay is interruptible like a paste-bomb. Wired
    // into the document-level keydown listener above (any keystroke,
    // REGARDLESS of focus — the canonical #play= scenario, where nothing has
    // focused the input and activeElement is body), the FIRST statements of
    // the input's onKeydown (the dismissIdleHint placement precedent), the
    // chip-tap handler, and the input's paste handler (a mouse-driven
    // context-menu paste is an interaction too). commitLine does NOT call
    // stopReplay — replay commits through commitLine itself (the deliberate
    // asymmetry, mirroring the pendingNav contrast: user action kills the
    // replay; the replay's own machinery must not). Interrupting mid-word
    // freezes whatever was typed — the next user action deals with the
    // partial line exactly as if hand-typed. Idempotent and cheap, so the
    // call sites need no active-flag gate.
    function stopReplay(): void {
      document.removeEventListener('keydown', onReplayKeydown, { capture: true });
      replayQueue = [];
      // The completion hook dies with the sequence (change 4vkd): an
      // interrupted tour prints no closing CTA — already-printed narration
      // stays, the partial line freezes, exactly like a hand-typed abort.
      replayOnDone = undefined;
      if (replayTyper !== undefined) {
        window.clearInterval(replayTyper);
        replayTyper = undefined;
      }
      if (replayTimer !== undefined) {
        window.clearTimeout(replayTimer);
        replayTimer = undefined;
      }
    }

    // Drive Starlight's EXISTING theme provider via the header <select>, so the
    // header toggle, <html data-theme>, and localStorage persistence all update
    // through Starlight's own onThemeChange (no reinvented persistence).
    function setTheme(arg: string | undefined): Line[] {
      const select = document.querySelector<HTMLSelectElement>(
        'starlight-theme-select select',
      );
      const current =
        document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';

      let target: 'dark' | 'light';
      if (!arg) {
        target = current === 'dark' ? 'light' : 'dark';
      } else if (arg === 'dark' || arg === 'light') {
        target = arg;
      } else {
        return [{ text: 'usage: theme [dark|light]', classes: 'shell-out' }];
      }

      if (select) {
        select.value = target;
        select.dispatchEvent(new Event('change', { bubbles: true }));
      } else {
        // Fallback if the header select isn't present: flip data-theme directly.
        document.documentElement.dataset.theme = target;
      }
      return [{ text: `theme → ${target}`, classes: 'shell-out shell-ok' }];
    }

    // Click anywhere in the terminal focuses the live prompt (caret to end) —
    // matching how a real terminal grabs the cursor. We skip when the click
    // landed on a link (let it navigate) or when the user is selecting text
    // (don't steal a copy-selection), so the affordance never fights the user.
    function onClick(e: MouseEvent): void {
      // A click on the terminal surface is interaction — spend the idle ghost
      // hint before the focus-affordance early-returns below (a link click or
      // an in-progress text selection still counts as interaction).
      dismissIdleHint();
      const target = e.target as HTMLElement | null;
      if (target?.closest('a')) return;
      // Chip taps bubble here too — bail so the focus affordance doesn't run
      // right after a chip commit and summon the soft keyboard the chip path
      // deliberately avoids (change by18). The hint dismissal above still
      // counts the tap as interaction.
      if (target?.closest('.terminal-cmdbar')) return;
      if ((window.getSelection()?.toString() ?? '') !== '') return;
      if (target === input) return; // native click already places the caret
      input.focus();
      caretToEnd();
    }

    // ── On-screen command bar (change by18) ──────────────────────────────────
    // A row of tappable chips on the terminal's bottom edge — one-tap access to
    // the highest-value commands for touch users who can't reach ↑/↓/Tab.
    // Island-injected as the LAST child of .terminal-window, BELOW the
    // pre.shell-session scroll viewport: it reads as a keyboard-accessory row
    // adjacent to where the OS keyboard rises, and living outside the session
    // leaves the resting-state anchor, scrollToBottom, and the live-prompt-
    // last-child DOM-order invariant untouched. Hidden by default; revealed
    // only under (hover: none) and (pointer: coarse) in terminal.css. Native
    // <button>s: tap, Enter, and Space all fire `click` — keyboard-operable
    // with a :focus-visible ring for free (Constitution accessibility).
    function injectCommandBar(): void {
      const win = session!.closest<HTMLElement>('.terminal-window');
      if (!win) return; // no frame → no accessory bar (tap-to-focus still works)
      const bar = document.createElement('div');
      bar.className = 'terminal-cmdbar';
      bar.setAttribute('role', 'group');
      bar.setAttribute('aria-label', 'quick commands');
      for (const cmd of CHIP_COMMANDS) {
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.className = 'terminal-chip';
        chip.dataset.cmd = cmd;
        chip.textContent = cmd;
        bar.appendChild(chip);
      }
      // One delegated listener for the whole bar (not one per button).
      bar.addEventListener('click', onChipClick);
      win.appendChild(bar);
    }

    // A chip tap runs the command exactly as if the user had typed it and
    // pressed Enter — same dismissal, same history, same dispatch, same single
    // fresh prompt — via the shared commitLine. focusNext = false: do NOT
    // focus the contenteditable, or the soft keyboard would pop over the
    // output the user just asked for (the keyboard appears only when they tap
    // the prompt itself). The surface onClick bails on .terminal-cmdbar
    // clicks, so the bubbled click can't re-focus the input afterward either.
    function onChipClick(e: MouseEvent): void {
      const chip = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>(
        'button.terminal-chip',
      );
      if (!chip) return;
      // A chip tap is interaction — spend the idle ghost hint. (The surface
      // onClick also dismisses it, but the chip handler must not depend on
      // listener ordering; dismissIdleHint is a one-shot latch, so the second
      // call is a no-op, never a double-fire.)
      dismissIdleHint();
      // A chip tap also kills an in-flight deep-link replay (change tx5p) —
      // the touch analogue of the onKeydown kill switch.
      stopReplay();
      input.textContent = chip.dataset.cmd ?? '';
      commitLine(false);
    }

    // ── Activate ─────────────────────────────────────────────────────────────
    // Replace the static "$ ▊" line with a live, focusable prompt. The static
    // markup (with its blinking cursor) was the no-JS source of truth; we now
    // remove it and emit the first interactive prompt in its place.
    const clickSurface = session.closest<HTMLElement>('.terminal-window') ?? session;
    clickSurface.addEventListener('click', onClick);
    clickSurface.style.cursor = 'text'; // hint the whole area is typeable
    injectCommandBar(); // touch-only quick-command chips (change by18)
    // Live region (change cuur): everything print()/printBeforePrompt() appends
    // is announced to screen readers — before this, the island's output was
    // silent after Enter (well-labeled input, invisible results). polite, not
    // assertive: announce after the user's keystroke settles. atomic=false:
    // announce only the appended nodes, never re-read the whole transcript.
    // Set BEFORE the greeting prints so the greeting announces once on load —
    // the right SR introduction to an interactive region. Island-only: the
    // static no-JS transcript stays inert and needs nothing. What stays silent
    // by construction: the aria-hidden ghost hint (hidden additions aren't
    // announced), clear/Ctrl-L (removals aren't announced), and each fresh
    // prompt's `$` (aria-hidden in freshPrompt). The Ctrl-C `^C` text suffix
    // IS a text addition — announcing it is correct cancel feedback.
    session.setAttribute('aria-live', 'polite');
    session.setAttribute('aria-atomic', 'false');
    promptLine.remove();
    // Greeting first — one dim line carrying the value prop + invitation —
    // then the first live prompt (no autofocus), then anchor the resting
    // viewport so the greeting is the first visible line (change 23xc).
    print([{ text: GREETING, classes: 'shell-out shell-dim' }]);
    const greetingEl = session.lastElementChild as HTMLElement;
    freshPrompt(false);
    anchorToGreeting(greetingEl);
    const anchoredScrollTop = session.scrollTop;
    // JetBrains Mono loads async and shifts line metrics — re-anchor once the
    // fonts are in, but only while still resting and only if the user hasn't
    // scrolled away from the anchored position in the meantime.
    document.fonts?.ready.then(() => {
      if (resting && Math.abs(session.scrollTop - anchoredScrollTop) < 2) {
        anchorToGreeting(greetingEl);
      }
    });
    armIdleHint();
    // Deep-link replay (change tx5p): parse #play=… AFTER the greeting and
    // resting anchor settle. The RAW fragment via new URL(location.href) —
    // NOT location.hash, which some engines (longstanding Firefox behavior)
    // return percent-decoded, breaking the split-before-decode contract: an
    // encoded %2C inside an arg would arrive as a raw separator, and tokens
    // would be double-decoded (review cycle 1). The predicate drops unknown
    // and REPLAY_DENY'd tokens silently (Object.hasOwn — the hash is
    // user-controlled input keying a record lookup); zero survivors →
    // startReplay no-ops and the load is byte-for-byte today's behavior.
    // The hash is deliberately left in place (no replaceState): a reload
    // replays again — a deep link is replayable by definition. startReplay
    // dismisses the idle hint armed just above (machine interaction is
    // still interaction).
    startReplay(
      parsePlayHash(new URL(location.href).hash, (cmd) => isReplayable(cmd, COMMANDS)),
    );
  }
</script>

{/* The build-time tool-help payload (change 37ng): ONE application/json
    element — never rendered, never executed — that the island parses at
    activation to source the bare-tool-name cards. Living in this component's
    own template keeps index.mdx byte-identical (the progressive-enhancement
    source of truth gains nothing visible: data script elements don't render). */}
<script is:inline type="application/json" data-terminal-help set:html={toolHelpJson} />
