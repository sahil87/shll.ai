        // missing-operand fallback was a double-duty `cls === 'refuse' &&
        // target` condition — now each class owns its branch explicitly).
        const cls = classifyRm(args);
        if (cls === 'deluxe') {
          // rmDeluxe streams and returns void — keep the void call and the
          // handler's (line-less) return decoupled.
          rmDeluxe();
          return;
        }
        if (cls === 'guarded-root') {
          // Two authentic lines, NO joke line — the authenticity is the
          // invitation to type the override.
          return [
            { text: "rm: it is dangerous to operate recursively on '/'", classes: 'shell-out' },
            { text: 'rm: use --no-preserve-root to override this failsafe', classes: 'shell-out' },
          ];
        }
        if (cls === 'refuse') {
          // `refuse` needs a removable target; a flags-only invocation
          // (`rm -f`) has none and falls to the missing-operand lines below.
          const target = args.find((a) => !a.startsWith('-'));
          if (target) {
            return [
              { text: `rm: cannot remove '${target}': Read-only file system`, classes: 'shell-out' },
              { text: '(this site ships as static files. deletion was never on the table.)', classes: 'shell-comment' },
            ];
          }
        }
        // `missing` — and target-less `refuse` — land here, with the
        // deliberate invitation to the deluxe egg.
        return [
          { text: 'rm: missing operand', classes: 'shell-out' },
          { text: "(try 'rm -rf /' if you're feeling brave.)", classes: 'shell-comment' },
        ];
      },

      mkdir(args) {
        const target = args.find((a) => !a.startsWith('-'));
        if (!target) return [{ text: 'mkdir: missing operand', classes: 'shell-out' }];
        return [
          { text: `mkdir: cannot create directory '${target}': Read-only file system`, classes: 'shell-out' },
          { text: '(want something built? write a spec. fab-kit insists.)', classes: 'shell-comment' },
        ];
      },

      touch(args) {
        const target = args.find((a) => !a.startsWith('-'));
        if (!target) return [{ text: 'touch: missing file operand', classes: 'shell-out' }];
        return [
          { text: `touch: cannot touch '${target}': Read-only file system`, classes: 'shell-out' },
          { text: '(the agents do the typing around here.)', classes: 'shell-comment' },
        ];
      },

      mv(args) {
        if (args.length < 2) return [{ text: 'mv: missing file operand', classes: 'shell-out' }];
        return [
          { text: `mv: cannot move '${args[0]}': Read-only file system`, classes: 'shell-out' },
          { text: '(this site is immutable. like a good artifact.)', classes: 'shell-comment' },
        ];
      },

      cp(args) {
        if (args.length < 2) return [{ text: 'cp: missing file operand', classes: 'shell-out' }];
        return [
          { text: `cp: cannot create regular file '${args[1]}': Read-only file system`, classes: 'shell-out' },
          { text: '(every site in this repo is an original.)', classes: 'shell-comment' },
        ];
      },

      chmod(args) {
        if (args.length === 0) return [{ text: 'chmod: missing operand', classes: 'shell-out' }];
        const target = args[args.length - 1];
        if (args.includes('777')) {
          return [
            { text: `chmod: changing permissions of '${target}': absolutely not`, classes: 'shell-out' },
            { text: '(777? we plan our permissions here.)', classes: 'shell-comment' },
          ];
        }
        return [
          { text: `chmod: changing permissions of '${target}': Operation not permitted`, classes: 'shell-out' },
          { text: "(ironic, isn't it.)", classes: 'shell-comment' },
        ];
      },

      chown(args) {
        if (args.length === 0) return [{ text: 'chown: missing operand', classes: 'shell-out' }];
        return [
          { text: `chown: changing ownership of '${args[args.length - 1]}': Operation not permitted`, classes: 'shell-out' },
          // The conversion hook: ownership is for keeps, via install.
          { text: "(visitors stay visitors. the toolkit can be yours, though — try 'install'.)", classes: 'shell-comment' },
        ];
      },

      // ── Tier A: terminal-culture one-shots ──
      diff(args) {
        if (args.length < 2) {
          return [
            { text: 'usage: diff <a> <b>', classes: 'shell-out' },
            { text: '(try: diff plan reality)', classes: 'shell-comment' },
          ];
        }
        const a = args[0].toLowerCase();
        const b = args[1].toLowerCase();
        if ((a === 'plan' && b === 'reality') || (a === 'reality' && b === 'plan')) {
          // Authentic normal-diff format, then the thesis.
          return [
            { text: '1c1', classes: 'shell-out' },
            { text: '< everything you planned', classes: 'shell-out' },
            { text: '---', classes: 'shell-out' },
            { text: '> everything that happened', classes: 'shell-out' },
            { text: "(that's why we plan.)", classes: 'shell-comment' },
          ];
        }
        return [{ text: `diff: ${args[0]} and ${args[1]} differ in every line that matters.`, classes: 'shell-out' }];
      },

      tar(args) {
        // The xkcd-1168 flag gauntlet, classified by terminal-eggs.ts.
        if (classifyTar(args) === 'survivor') {
          return [
            { text: 'congratulations: a valid tar invocation on the first try.', classes: 'shell-out' },
            { text: "(xkcd 1168 survivors club. membership is smaller than you'd think.)", classes: 'shell-comment' },
          ];
        }
        return [
          { text: 'tar: This does not look like a tar archive', classes: 'shell-out' },
          { text: 'tar: Exiting with failure status due to previous errors', classes: 'shell-out' },
          { text: '(xkcd 1168: you had ten seconds.)', classes: 'shell-comment' },
        ];
      },

      make(args) {
        const target = (args[0] ?? '').toLowerCase();
        if (!target) {
          return [
            { text: 'make: *** No targets specified and no makefile found.  Stop.', classes: 'shell-out' },
            { text: '(try: make plan)', classes: 'shell-comment' },
          ];
        }
        if (target === 'plan') {
          // The converting gag: the one buildable target IS the product.
          // Reuses SYNOPSIS + ROUTE_OVERVIEW (zero copy duplication; same
          // html:true trusted-static-anchor pattern as man).
          return [
            { text: "make: building 'plan'...", classes: 'shell-out' },
            { text: `fab-kit — ${SYNOPSIS['fab-kit']}`, classes: 'shell-out' },
            { text: `see: <a href="${ROUTE_OVERVIEW('fab-kit')}">${ROUTE_OVERVIEW('fab-kit')}</a>`, classes: 'shell-out shell-dim', html: true },
          ];
