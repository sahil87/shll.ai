          { text: '', classes: 'shell-out' },
          { text: "you meant 'ls'. (we all do.)", classes: 'shell-comment' },
        ];
      },

      fortune() {
        const f = FORTUNES[Math.floor(Math.random() * FORTUNES.length)];
        return [{ text: f, classes: 'shell-out' }];
      },

      exit: exitHandler,
      ':q': exitHandler,

      // ── GNU-utils easter eggs (change o33t) ────────────────────────────────
      // Tiers A (stateless one-shots), B (light logic), C (animated, via
      // startStream). Curation rule (user-approved): every command must teach
      // the toolkit, reward terminal-culture recognition, or demo
      // interactivity — no bare error stubs without a punchline. All keys are
      // unlisted eggs: the top-level `help` list stays byte-identical and each
      // key answers `help <cmd>` / `man <cmd>` via HELP_DETAIL. NOTE: the new
      // keys are appended AFTER all pre-existing keys so the did-you-mean
      // suggester's equal-distance tie-break (first key in iteration order)
