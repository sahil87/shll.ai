          { text: '/home/visitor/plans', classes: 'shell-out' },
          { text: '(you are exactly where you planned to be.)', classes: 'shell-comment' },
        ];
      },

      uname(args) {
        // Bare: just the OS. Any flag (-a etc.): the full plan-first boot brag.
        if (args.length === 0) return [{ text: 'shllOS', classes: 'shell-out' }];
        return [{ text: 'shllOS shll.ai 7.0-plan-first #1 SMP plan-first scheduler x86_64', classes: 'shell-out' }];
      },

      id() {
        return [{ text: 'uid=1000(visitor) gid=7(planners) groups=7(planners),20(curious)', classes: 'shell-out' }];
      },

      date() {
        return [
          { text: new Date().toString(), classes: 'shell-out' },
          { text: '(a good day to write a spec.)', classes: 'shell-comment' },
        ];
      },

      uptime() {
        // Real page age from performance.now(); the loads are the
        // seven-tools wink (0.07 across the board, forever).
        const sec = Math.floor(performance.now() / 1000);
        const age = sec < 60 ? `${sec} sec` : `${Math.floor(sec / 60)} min`;
        const clock = new Date().toTimeString().slice(0, 8);
        return [{ text: ` ${clock} up ${age}, 1 visitor, load average: 0.07, 0.07, 0.07`, classes: 'shell-out' }];
      },

      env() {
        // FAKE_ENV as KEY=value, declaration order — the same record echo
        // expands against.
        return Object.entries(FAKE_ENV).map(([k, v]) => ({ text: `${k}=${v}`, classes: 'shell-out' }));
      },

      // ── Tier A: read-only refusals ──
      // First line keeps the authentic GNU error shape; the second is the
      // punchline. No fake filesystem (the backlog [o33t] constraint, fully
      // honored) — every file-op refuses, honestly.
      rm(args) {
