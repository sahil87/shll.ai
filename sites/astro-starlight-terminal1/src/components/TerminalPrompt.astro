---
// TerminalPrompt.astro — progressive-enhancement client island for the homepage
// terminal transcript. With JS off, the hand-written <pre class="shell-session">
// in index.mdx renders verbatim (the static source of truth). With JS on, this
// script upgrades ONLY the final prompt line — the one marked
// [data-terminal-prompt] — into a focusable, typeable input that dispatches a
// static in-page command map. No network, no SSR, no endpoint (Constitution I);
// zero new dependencies, hand-rolled (Constitution VI). All printed output
// reuses the existing .shell-* classes + --c-* variables, so dark/light parity
// (Constitution V) comes for free.
//
// Precedent: src/components/Diagram.astro — a client island whose <script> does
// theme-reactive work via the data-theme attribute on <html>.
//
// Build-time tool-help payload (change 37ng): this frontmatter reads the
// repo-root help/*.json documents at BUILD TIME (the VersionTable precedent:
// ascend from import.meta.url to the repo root — a fixed relative depth breaks
// under Vite bundling), slims each doc to exactly what the bare-tool-name
// cards render ({ short, usage, commands[].{name,short} } — the `text` fields
// are KBs each and the card renders none of them), and emits ONE
// application/json element in the template below. The island parses it at
// activation (the versionRowsHtml capture-at-init precedent: build-time
// truth, island snapshot, no drift). No runtime fetch — Constitution I.
//
// Graceful degrade, PER TOOL (deliberate contrast with VersionTable's
// build-stop): a missing or invalid help/<slug>.json is skipped — omitted
// from the payload — and that tool's card falls back to its SYNOPSIS line +
// nav line. VersionTable already build-stops on any missing/invalid rostered
// doc, so it remains the build's defect gate and this degrade can never mask
// a committed defect.
import fs from 'node:fs';
import path from 'node:path';
import { HelpDocSchema } from '../lib/schemas.ts';
import { repoRootFromModuleUrl } from '../lib/repo-root.ts';
import { stripToolPrefix, stripUsagePrefix } from '../lib/terminal-toolcard.ts';

interface SlimToolHelp {
  short: string;
  usage: string;
  commands: { name: string; short: string }[];
}

const helpDir = path.join(repoRootFromModuleUrl(import.meta.url), 'help');

// Keyed by tool slug (the file name — help/run-kit.json held binary `rk`
// pre-v3.0.0; it holds `run-kit` after the corpus refresh).
// Enumerating the directory rather than a roster const: the island's TOOLS
// list is unreachable from this frontmatter, and the help/ collection IS the
// roster (a stray extra file would add an unreferenced entry, harmless).
const toolHelp: Record<string, SlimToolHelp> = {};
for (const file of fs.readdirSync(helpDir)) {
  if (!file.endsWith('.json')) continue;
  const slug = file.slice(0, -'.json'.length);
  let parsed: unknown;
  try {
    parsed = JSON.parse(fs.readFileSync(path.join(helpDir, file), 'utf8'));
  } catch {
    continue; // unreadable or malformed JSON → degrade this tool only
  }
  const doc = HelpDocSchema.safeParse(parsed);
  if (!doc.success) continue; // schema-invalid → degrade this tool only
  const { tool, root } = doc.data;
  toolHelp[slug] = {
    // The §2 mechanical normalizations (change 37ng), applied at build time
    // where the binary name (doc.tool) is known — pure transforms of json
    // data, vn39-clean. Defined in terminal-toolcard.ts so the unit tests
    // pin them.
    short: stripToolPrefix(root.short, tool),
    usage: stripUsagePrefix(root.usage),
    commands: root.commands.map((c) => ({ name: c.name, short: c.short })),
  };
}

// `<` → \u003c so the serialized payload can never terminate its own
// <script> element early (standard embedded-JSON hygiene).
const toolHelpJson = JSON.stringify(toolHelp).replace(/</g, '\\u003c');
---

<script>
  // Did-you-mean matcher (change cuur) — dependency-free, extracted to
  // src/lib/ so it's unit-testable under node --test (scripts/
  // terminal-suggest.test.mjs); Vite bundles it into this island.
  import { suggestCommand } from '../lib/terminal-suggest.ts';
  // GNU-utils egg logic (change o33t) — same lib pattern: echo's $VAR
  // expansion, seq generation, and the rm/tar argument classifiers, pinned
  // by scripts/terminal-eggs.test.mjs.
  import { expandVars, seqLines, classifyRm, classifyTar, SEQ_GEN_CAP } from '../lib/terminal-eggs.ts';
  // Cheatsheet logic (change cdbr) — same lib pattern again: the anti-drift
  // coverage/alias/stale-drop computation and the width-budget chunking,
  // pinned by scripts/terminal-cheatsheet.test.mjs.
  import { buildCheatsheet, chunkLine, type CheatGroup } from '../lib/terminal-cheatsheet.ts';
  // Tool-card logic (change 37ng) — the lib pattern a fourth time: card
  // assembly (header/usage normalization, name-column padding, ellipsis
  // truncation, the subcommand cap) and the subcommand lookup, pinned by
  // scripts/terminal-toolcard.test.mjs. ToolHelpDoc is the slim build-time
  // payload shape this component's frontmatter embeds.
  import {
    buildToolCard,
    findSubcommand,
    formatSubcommandLine,
    type ToolHelpDoc,
  } from '../lib/terminal-toolcard.ts';
  // Share + deep-link replay logic (change tx5p) — the lib pattern a FIFTH
  // time: the #play= hash grammar (parse + build, round-tripping), the shared
  // replayable predicate (recording and parsing can never drift), and the
  // self-advertising transcript serializer, pinned by
  // scripts/terminal-share.test.mjs. The DOM walk and the clipboard stay
  // island-side; the lib takes plain strings.
  import {
    buildPlayHash,
    isReplayable,
    parsePlayHash,
    serializeTranscript,
  } from '../lib/terminal-share.ts';
  // Arcade-pass logic (change kd5e) — the lib pattern a SIXTH time: the
  // cowsay bubble builder, the cmatrix line generator (RNG injected so
  // tests pin shape deterministically), and the snake game core (init,
  // steering, the pure state → state tick, the board renderer), pinned by
  // scripts/terminal-toys.test.mjs. The island keeps only the timers, the
  // DOM writes, and the key wiring.
  import {
    cowsayBubble,
    cmatrixLines,
    snakeInit,
    snakeStep,
    snakeTurn,
    renderSnakeBoard,
    type SnakeDir,
    type SnakeState,
  } from '../lib/terminal-toys.ts';

  // ── Types ────────────────────────────────────────────────────────────────
  // `ariaHidden` (change o33t): hides the line from the cuur aria-live
  // region — ASCII art and rapid stream frames are announcement garbage; each
  // such command prints one announced, readable summary line instead.
  type Line = { text: string; classes?: string; html?: boolean; ariaHidden?: boolean };
  type Handler = (args: string[], ctx: Ctx) => Line[] | void;
  interface Ctx {
    print: (lines: Line[]) => void;
    clear: () => void;
    raw: string; // the full entered line, after the command token
  }
  // One machine-typed step (change 4vkd, generalizing the tx5p replay queue):
  // optional narration lines print (announced, dim) above the live prompt
  // before the command types. The #play= path maps its bare tokens to
  // narration-less steps — behaviorally byte-identical to the original
  // string queue; the demo's DEMO_SCRIPT steps carry the story layer a bare
  // replay can't.
  type ReplayStep = { narration?: string[]; command: string };
  // One illustrated short (change jf9k): `frames` stream one per tick at
  // PLAY_TICK_MS, hidden from the live region (the handler applies
  // ariaHidden at the single stream site); `endFrame` is the settled static
  // state prefers-reduced-motion shows INSTEAD of the stream; `summary` is
  // the ONE announced line a screen reader hears in place of the hidden
  // frames (the o33t one-announced-summary rule).
  type PlayScript = { frames: Line[]; endFrame: Line[]; summary: string };

  // ── Constants (no magic strings) ───────────────────────────────────────────
  // The 7 tools, in the canonical order used across the site.
  const TOOLS = ['idea', 'hop', 'fab-kit', 'wt', 'run-kit', 'tu', 'shll'] as const;

  // NOTE: `version` does NOT keep a hardcoded version list. As of #47 the homepage
  // `$ shll version` block is rendered by <VersionTable/> (build-time, self-updating
  // from help/*.json). The terminal's `version` command captures those already-
  // rendered rows from the DOM at init (see initTerminal → versionRowsHtml) so it
  // re-prints exactly what the page shows and the two can never drift.

  // One-line synopsis per tool, for `man`.
  const SYNOPSIS: Record<string, string> = {
    idea: 'capture an idea, fan it out into parallel agents.',
    hop: 'jump between worktrees, branches, and tools without losing your place.',
    'fab-kit': 'turn a rough idea into a reviewed spec before any code is written.',
    wt: 'spin up isolated git worktrees so agents never trip over each other.',
    'run-kit': 'watch parallel runs converge into one live dashboard.',
    tu: 'track token usage and cost across every agent run.',
    shll: 'the meta-CLI that bootstraps and ties the whole toolkit together.',
  };

  // Per-command detail for `help <command>` (change cuur): one usage line plus
  // one dim elaboration line each (the man-page shape: synopsis + see-also dim
  // tier) — printed only on request, so the top-level `help` list stays short.
  // EVERY key in COMMANDS has an entry, hidden eggs included: `help sudo`
  // answers once you've found sudo, but the list never enumerates the eggs
  // (answering a direct question is not advertising — the discovery ethos
  // stands).
  const helpDetail = (usage: string, detail: string): Line[] => [
    { text: `  ${usage}`, classes: 'shell-out' },
    { text: `  ${detail}`, classes: 'shell-out shell-dim' },
  ];
  // Tool-card help entries (change 37ng): six near-identical entries, one
  // factory — the helpDetail shape for the six bare tool-name commands
  // appended at the record's tail below (one body, no six-way copy drift).
  const toolCardHelp = (slug: string): Line[] =>
    helpDetail(
      `${slug} [command] — ${slug}'s card, from its own help`,
      `usage + subcommands, machine-fresh. 'cd ${slug}' opens the full docs.`,
    );
  const HELP_DETAIL: Record<string, Line[]> = {
