        }
        return [
          { text: `make: *** No rule to make target '${target}'.  Stop.`, classes: 'shell-out' },
          { text: "(only 'plan' is buildable here. naturally.)", classes: 'shell-comment' },
        ];
      },

      // The editor holy war — two keys, one handler (the exitHandler shape).
      vim: editorHandler,
      vi: editorHandler,

      emacs() {
        return [{ text: "a fine operating system. all it's missing is a good terminal website.", classes: 'shell-out' }];
      },

      nano() {
        return [{ text: "nano: too sensible to joke about. (try 'vim'.)", classes: 'shell-out' }];
      },

      // No fake network (the backlog [o33t] constraint, fully honored) —
      // both deniers print their own name via one shared handler.
      curl() {
        return denyNetwork('curl');
      },
      wget() {
        return denyNetwork('wget');
      },

      // Two keys, byte-identical output — that IS the gag.
      less: lessHandler,
      more: lessHandler,

      kill(args) {
        const pid = args.find((a) => !a.startsWith('-'));
        if (!pid) {
          return [
            { text: 'kill: usage: kill <pid>', classes: 'shell-out' },
            { text: "(you don't know their pids. that's rather the point.)", classes: 'shell-comment' },
          ];
        }
