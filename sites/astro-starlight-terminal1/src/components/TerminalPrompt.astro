    // their primaries (rk → run-kit short alias; fab → fab-kit binary).
    // `man rk`/`man fab` answer from these via the o33t bridge (not in TOOLS,
    // so they fall through to HELP_DETAIL).
    idea: toolCardHelp('idea'),
    hop: toolCardHelp('hop'),
    'fab-kit': toolCardHelp('fab-kit'),
    wt: toolCardHelp('wt'),
    'run-kit': toolCardHelp('run-kit'),
    tu: toolCardHelp('tu'),
    rk: helpDetail(
      "rk — run-kit's card, by its short alias  (alias of run-kit)",
      "the same card — rk is a short alias; run-kit is canonical. 'cd run-kit' navigates.",
