  // is `/<tool>/` and its siblings are `/<tool>/readme/` / `/<tool>/commands/`.
  const ROUTE_OVERVIEW = (tool: string) => `/${tool}/`;
  const ROUTE_INSTALL = '/getting-started/install/';
  // Per-tool sibling pages (change 37ng): every tool has all three (verified
  // at intake) — the tool cards' nav line links them all.
  const ROUTE_README = (tool: string) => `/${tool}/readme/`;
  const ROUTE_COMMANDS = (tool: string) => `/${tool}/commands/`;

  // Activation-time greeting (change 23xc): one dim line stating what shll is
  // plus the invitation, printed by the island BEFORE the first live prompt so
  // the value prop sits where the top-anchored resting viewport rests the eye.
  // Island-printed only — the static no-JS transcript in index.mdx stays
  // byte-identical (the progressive-enhancement source of truth). Kept short
  // enough that the tail invitation survives the session's `white-space: pre`
  // on common laptop widths (long lines clip into horizontal scroll).
  const GREETING = "seven small CLIs that force agents to plan first. type 'help' or 'ls'.";

  // Idle ghost hint (change 23xc): after HINT_DELAY_MS without interaction, a
