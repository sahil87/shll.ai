  // Dev aphorisms for `fortune` — all tie to "plan before they code".
  const FORTUNES = [
    'Weeks of coding can save you hours of planning.',
    'A plan is just a hypothesis with better manners.',
    'The fastest agent is the one that thought first.',
    'Measure twice, prompt once.',
    'No spec survives contact with the codebase — write it anyway.',
