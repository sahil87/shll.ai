        // shll is PID 1: the meta-CLI that bootstraps the toolkit is init,
        // that's the joke. The visitor row shows REAL elapsed session time.
        const sec = Math.floor(performance.now() / 1000);
        const elapsed = [
          String(Math.floor(sec / 3600)).padStart(2, '0'),
          String(Math.floor(sec / 60) % 60).padStart(2, '0'),
          String(sec % 60).padStart(2, '0'),
