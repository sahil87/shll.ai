  // trusts nothing (the sessionStorage try/catch discipline): an absent
  // element or malformed payload degrades to an empty record, in which case
  // every tool card falls back to its SYNOPSIS line + nav line.
  function loadToolHelp(): Record<string, ToolHelpDoc> {
    try {
      const el = document.querySelector('script[data-terminal-help]');
      const parsed: unknown = JSON.parse(el?.textContent ?? '');
      if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
        return parsed as Record<string, ToolHelpDoc>;
      }
    } catch {
      // fall through — degrade to the empty record
    }
    return {};
  }
