      seq(args) {
        const lines = seqLines(args);
        if (lines === null) {
          return [
            { text: 'seq: invalid argument', classes: 'shell-out' },
            { text: 'usage: seq [first [incr]] last', classes: 'shell-out shell-dim' },
          ];
        }
