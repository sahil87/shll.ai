      sl() {
        // The classic fat-finger-of-`ls` gag — upgraded by change o33t: the
        // locomotive now CROSSES the viewport right-to-left via CSS
        // (.shell-art-train / @keyframes shell-train in terminal.css) and the
        // art container is removed on animationend — the train has left; the
        // punchline remains directly under the echoed command. The 7 art rows
        // live in one aria-hidden container (live-region noise control, same
        // policy as the shll splash) while the punchline below stays
        // announced. Under prefers-reduced-motion the existing CSS gate sets
        // animation: none — the art renders statically exactly as before and
        // animationend never fires, so the art stays. Motion-safety is purely
        // CSS; no JS branch.
        const art = [
          '      ====        ________                ___________ ',
          '  _D _|  |_______/        \\__I_I_____===__|_________| ',
          '   |(_)---  |   H\\________/ |   |        =|___ ___|   ',
          '   /     |  |   H  |  |     |   |         ||_| |_||   ',
          '  |      |  |   H  |__--------------------| [___] |   ',
          '  | ________|___H__/__|_____/[][]~\\_______|       |   ',
          '  |/ |   |-----------I_____I [][] []  D   |=======|__ ',
        ];
        const train = document.createElement('span');
        train.className = 'shell-art-train';
        train.setAttribute('aria-hidden', 'true');
        const inner = document.createElement('span');
        inner.className = 'shell-train-inner';
        for (const row of art) {
          const el = document.createElement('span');
          el.className = 'shell-line shell-out';
          el.textContent = row;
          inner.appendChild(el);
        }
        train.appendChild(inner);
        inner.addEventListener('animationend', () => train.remove());
        // Appended directly (run() executes before commitLine's freshPrompt,
        // exactly like print()); the returned punchline lines land after it.
        session!.appendChild(train);
