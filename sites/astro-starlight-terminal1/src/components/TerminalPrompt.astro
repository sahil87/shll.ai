        // the lib's own generation bound (SEQ_GEN_CAP) keeps absurd ranges
        // from freezing the tab, and the `+` keeps the cap line honest.
        const out: Line[] = lines.slice(0, SEQ_CAP).map((n) => ({ text: n, classes: 'shell-out' }));
        if (lines.length > SEQ_CAP) {
          const total = `${lines.length}${lines.length >= SEQ_GEN_CAP ? '+' : ''}`;
          out.push({ text: `(capped at ${SEQ_CAP} of ${total} — this terminal believes in scope control.)`, classes: 'shell-comment' });
        }
        return out;
      },

      ps() {
