        // FAKE_ENV — the same record `env` prints, one source, no drift.
        // `echo hello` is unchanged; an unknown name expands to '' (authentic
        // shell behavior), so `echo $UNDEFINED` prints an empty line.
        return [{ text: expandVars(ctx.raw, FAKE_ENV), classes: 'shell-out' }];
      },

      man(args) {
        const topic = (args[0] ?? '').toLowerCase();
        if (!topic) {
          return [{ text: 'what manual page do you want?  try: man <tool>', classes: 'shell-out' }];
        }
        // Tools keep precedence (man shll still prints the TOOL synopsis,
        // never the command's HELP_DETAIL entry).
        if (isTool(topic)) {
          return [
            { text: `${topic} — ${SYNOPSIS[topic]}`, classes: 'shell-out' },
            { text: `see: <a href="${ROUTE_OVERVIEW(topic)}">${ROUTE_OVERVIEW(topic)}</a>`, classes: 'shell-out shell-dim', html: true },
          ];
        }
        // HELP_DETAIL bridge (change o33t): any command key answers from the
        // same record `help <cmd>` reads — one source, no drift. Anything
        // else gets the authentic no-entry line plus the cuur suggester tail
        // (replacing the old fall-through to unknownTool, which wrongly
        // framed every non-tool argument as a failed tool lookup).
        // Own-property guard (change o33t review rework): an unguarded read
        // walks the prototype chain — `man constructor` / `man toString`
        // returned an inherited truthy member, print() threw on the
        // non-iterable, and commitLine aborted BEFORE freshPrompt, leaving
        // the terminal with zero prompts (bricked until reload).
        const detail = Object.hasOwn(HELP_DETAIL, topic) ? HELP_DETAIL[topic] : undefined;
        if (detail) return detail;
        const suggestion = suggestCommand(topic, Object.keys(COMMANDS));
        const tail = suggestion ? ` — did you mean '${suggestion}'?` : '';
        return [{ text: `No manual entry for ${topic}${tail}`, classes: 'shell-out' }];
