      "you meant 'ls'. we all do. enjoy the train.",
    ),
    exit: helpDetail(
      'exit — leave the shell',
      'there is no escape from the shll.  (also: :q)',
    ),
    ':q': helpDetail(
      ':q — leave the shell, vim-style',
      'there is no escape from the shll.  (also: exit)',
    ),
    // The GNU-utils eggs (change o33t) — answered, never listed. Usage lines
    // are the intake's §0e roster verbatim; `man <cmd>` bridges to these same
    // entries, so help and man can never drift.
    pwd: helpDetail(
      'pwd — print the working directory',
      "you're in /home/visitor/plans. naturally.",
    ),
    uname: helpDetail(
      'uname [-a] — print system information',
      'shllOS. add -a for the full plan-first boot brag.',
    ),
    id: helpDetail(
      'id — print your identity',
      'uid 1000, groups planners and curious. membership was automatic.',
    ),
    date: helpDetail(
      'date — print the current date',
      "the real one — some things here aren't a bit.",
    ),
    uptime: helpDetail(
      'uptime — how long this page has been up',
      'real time since page load. the load averages are always 0.07.',
    ),
    env: helpDetail(
      'env — print the environment',
      'the variables this shell believes in. echo expands them.',
    ),
    rm: helpDetail(
      'rm <file> — remove files (you can try)',
      'the filesystem is read-only. the classics are still worth typing.',
    ),
    mkdir: helpDetail(
      'mkdir <dir> — create a directory (you can try)',
      'read-only filesystem. want something built? write a spec.',
    ),
    touch: helpDetail(
      'touch <file> — create a file (you can try)',
      'nothing here gets touched without a plan.',
    ),
    mv: helpDetail(
      'mv <a> <b> — move files (you can try)',
      'nothing moves. this site is immutable, like a good artifact.',
    ),
    cp: helpDetail(
      'cp <a> <b> — copy files (you can try)',
      'no copies. every site in this repo is an original.',
    ),
    chmod: helpDetail(
      'chmod <mode> <file> — change permissions (you can try)',
      "permission to change permissions: denied. ironic, isn't it.",
    ),
    chown: helpDetail(
      'chown <owner> <file> — change ownership (you can try)',
      "visitors stay visitors. 'install' makes the toolkit yours, though.",
    ),
    diff: helpDetail(
      'diff <a> <b> — compare two things',
      "'diff plan reality' is the canonical comparison. try it.",
    ),
    tar: helpDetail(
      'tar <flags> — the flag gauntlet',
      'xkcd 1168 rules: a valid invocation on the first try, or the bomb.',
    ),
    make: helpDetail(
      'make [target] — build a target. there is exactly one.',
      "'make plan' is the only rule in this makefile. fitting.",
    ),
    vim: helpDetail(
      'vim — open the editor holy war',
      "you can't exit what you never entered. (also answers to 'vi'.)",
    ),
    vi: helpDetail(
      'vi — open the editor holy war  (alias of vim)',
      "you can't exit what you never entered.",
    ),
    emacs: helpDetail(
      'emacs — open the other side of the holy war',
      "a fine operating system. it's even got an editor.",
    ),
    nano: helpDetail(
      'nano — the sensible one',
      'it just works. no joke survives contact with nano.',
    ),
    curl: helpDetail(
      'curl <url> — fetch something over the network',
      'denied — there is no network here. the site is fully static.',
    ),
    wget: helpDetail(
      'wget <url> — fetch something over the network  (see: curl)',
      'denied — there is no network here. the site is fully static.',
    ),
    less: helpDetail(
      'less — page through output',
      "here, less and more are the same command. that's the joke.",
    ),
    more: helpDetail(
      'more — page through output  (see: less)',
      "here, more and less are the same command. that's the joke.",
    ),
    kill: helpDetail(
      'kill <pid> — send a signal',
      'signals bounce. the seven agents are protected by their planner.',
    ),
    true: helpDetail(
      'true — exit successfully, saying nothing',
      'prints nothing. succeeds quietly. the joke is that there is no joke.',
    ),
    false: helpDetail(
      'false — fail, also saying nothing',
      'prints nothing. fails quietly. somebody has to.',
    ),
    seq: helpDetail(
      'seq [first [incr]] last — print a number sequence',
      'integers only. display capped at 100 — scope control.',
    ),
    ps: helpDetail(
      'ps — list running processes',
      'the seven tools, plus you. shll is PID 1 for a reason.',
    ),
    sha256sum: helpDetail(
      'sha256sum <text> — hash your text, for real',
      'a real SHA-256 of your text, computed in your browser. no tricks.',
    ),
    grep: helpDetail(
      'grep <pattern> — search the seven tools',
      "case-insensitive match over each tool's one-line synopsis.",
    ),
    yes: helpDetail(
      'yes [text] — repeat until stopped',
      'repeats until Ctrl-C — or until it gives up at 50. try stopping it.',
    ),
    tail: helpDetail(
      "tail [-f] agents.log — follow the agents' log",
      'one logged run of all seven tools. spoiler: the log ends.',
    ),
    // The full-roster reveal (change cdbr) — appended after all existing
    // entries, matching its COMMANDS position.
    cheatsheet: helpDetail(
      'cheatsheet — the full command roster, grouped',
      "everything, including what 'help' won't admit to.",
    ),
  };

  // Dev aphorisms for `fortune` — all tie to "plan before they code".
  const FORTUNES = [
    'Weeks of coding can save you hours of planning.',
    'A plan is just a hypothesis with better manners.',
    'The fastest agent is the one that thought first.',
    'Measure twice, prompt once.',
    'No spec survives contact with the codebase — write it anyway.',
    'Plan before they code, or debug after they do.',
    'A clear spec is a refactor you never had to do.',
    'The best diff is the one you predicted.',
  ];

  const ROUTE_OVERVIEW = (tool: string) => `/tools/${tool}/overview/`;
  const ROUTE_INSTALL = '/getting-started/install/';

  // Activation-time greeting (change 23xc): one dim line stating what shll is
  // plus the invitation, printed by the island BEFORE the first live prompt so
  // the value prop sits where the top-anchored resting viewport rests the eye.
  // Island-printed only — the static no-JS transcript in index.mdx stays
  // byte-identical (the progressive-enhancement source of truth). Kept short
  // enough that the tail invitation survives the session's `white-space: pre`
  // on common laptop widths (long lines clip into horizontal scroll).
  const GREETING = "seven small CLIs that force agents to plan first. type 'help' or 'ls'.";

  // Idle ghost hint (change 23xc): after HINT_DELAY_MS without interaction, a
  // dim, aria-hidden, VISUAL-ONLY hint types into the live prompt line after
  // the block cursor (fish-autosuggestion style: `$ ▊try 'ls' ⏎`) to signal
  // "this is alive". One-shot per page view — any interaction before the timer
  // fires cancels it, any after dismisses it, and it never re-arms. Under
  // prefers-reduced-motion the full text appears statically (no typing).
  const HINT_TEXT = "try 'ls' ⏎";
  const HINT_DELAY_MS = 4000;
  const HINT_TYPE_MS = 70; // per-character typing cadence

  // Navigation beat (change cuur): cd/open/install no longer navigate on the
  // same tick as Enter — instant navigation off a playful exploration surface
  // reads as a misclick, yanking the visitor away before the `opening …` line
  // even registers. Instead the handler prints where it's headed (a real
  // clickable link) and navigates after this beat; Ctrl-C cancels the pending
  // timer (see navigateWithBeat / the Ctrl-C branch in onKeydown).
  const NAV_BEAT_MS = 900;

  // On-screen command bar (change by18): the chip roster, in display order.
  // Touch users get one-tap access to the commands the ghost hint and `help`
  // advertise — the touch analogue of ↑/↓/Tab. `install` is included: it is
  // the site's primary CTA and the chip reuses the existing command's real
  // navigation. The bar itself is island-injected (never static markup — dead
  // buttons without JS) and only *shown* on touch-primary devices via the
  // `(hover: none) and (pointer: coarse)` media query in terminal.css.
  const CHIP_COMMANDS = ['ls', 'help', 'version', 'install'] as const;

  // ── GNU-utils delight (change o33t) ─────────────────────────────────────
  // Fake environment — the single source for BOTH `env` (prints these as
  // KEY=value, declaration order) and `echo`'s $VAR expansion (expandVars
  // against the same record). One source, no drift.
  const FAKE_ENV: Record<string, string> = {
    SHELL: '/bin/shll',
    USER: 'visitor',
    HOME: '/home/visitor',
    EDITOR: 'spec',
    PLAN: 'first',
    AGENTS: '7',
    PATH: '/plans:/specs:/code',
    TERM: 'shll-256color',
  };

  // The fixed agents.log content for `tail` — timestamps are static literals
  // (13:37, leet o'clock), and the last line self-identifies the log as
  // static, defusing any implied-runtime read (the conscious mitigation for
  // the backlog's no-streaming-gags constraint).
  const AGENT_LOG = [
    '13:37:00 [idea]    captured: "what if the homepage was a terminal"',
    '13:37:01 [fab-kit] intake scored: 9 certain, 0 unresolved — gate passed',
    '13:37:02 [wt]      worktree created: a clean room for the agent',
    '13:37:03 [hop]     jumped: main → feature branch, context intact',
    '13:37:04 [run-kit] four panes, all green',
    '13:37:05 [tu]      tokens counted. budget respected.',
    '13:37:06 [shll]    shipped. plan first, then code. always.',
    '13:37:07 [shll]    log ends — nothing actually runs here. the site is static.',
  ];

  // Stream cadences and caps (change o33t) — named constants, following the
  // HINT_*/NAV_BEAT_MS convention above. `yes` is fast (the bit is the
  // flood), `tail` is slow (the lines are meant to be read), `rm` sits in
  // between (each removal should land) with a beat before the resolution.
  const YES_TICK_MS = 150;
  const YES_CAP = 50;
  // Reduced-motion `yes` prints this many static lines at once — enough to
  // suggest the forever without flooding (and a seven-tools wink).
  const YES_REDUCE_COUNT = 7;
  const TAIL_TICK_MS = 700;
  const RM_TICK_MS = 300;
  const RM_BEAT_MS = 900;
  const SEQ_CAP = 100; // display cap for `seq` output lines

  // ── Cheatsheet (change cdbr) ─────────────────────────────────────────────
  // The deliberate full-roster reveal: `help` stays the curated short list and
  // the eggs stay unlisted there, but `cheatsheet` maps the whole territory in
  // five fixed groups. Membership lives HERE, in one const beside the other
  // named rosters — and the handler recomputes coverage at runtime
  // (buildCheatsheet): any COMMANDS key missing from every group and not
  // declared alias-of is appended under `uncategorized`, so a future command
  // can never silently vanish from the sheet; a group key no longer in
  // COMMANDS is dropped at render (stale-entry tolerance). Every COMMANDS key
  // is covered exactly once: alias-of keys (CHEATSHEET_ALIASES) render with
  // their primary and are never double-listed, while true pairs (cd · open,
  // curl · wget, true · false) display both names adjacent. Display strings
  // may decorate beyond the bare key (`cd <tool>`, `make plan`) — the
  // decoration teaches the interesting invocation.
  const CHEATSHEET_GROUPS: CheatGroup[] = [
    {
      name: 'navigate',
      entries: [
        { key: 'ls' },
        { key: 'cd', display: 'cd <tool>' },
        { key: 'open' },
        { key: 'install' },
        { key: 'version' },
        { key: 'theme' },
        { key: 'clear' },
        { key: 'history' },
        { key: 'help' },
        { key: 'cheatsheet' }, // a key must be covered somewhere; help lists help
      ],
    },
    {
      name: 'look around',
      entries: [
        { key: 'pwd' },
        { key: 'uname' },
        { key: 'id' },
        { key: 'date' },
        { key: 'uptime' },
        { key: 'env' },
        { key: 'ps' },
        { key: 'whoami' },
      ],
    },
    {
      name: 'do things (try to)',
      entries: [
        { key: 'rm' },
        { key: 'mkdir' },
        { key: 'touch' },
        { key: 'mv' },
        { key: 'cp' },
        { key: 'chmod' },
        { key: 'chown' },
        { key: 'sudo' },
        { key: 'kill' },
        // curl/wget try network things and get refused — exactly like the
        // file-op refusals beside them.
        { key: 'curl' },
        { key: 'wget' },
      ],
    },
    {
      name: 'classics',
      entries: [
        { key: 'make', display: 'make plan' },
        { key: 'diff', display: 'diff plan reality' },
        { key: 'tar' },
        { key: 'vim' },
        { key: 'emacs' },
        { key: 'nano' },
        { key: 'less' },
        { key: 'yes' },
        { key: 'sl' },
        { key: 'tail', display: 'tail -f agents.log' },
        { key: 'fortune' },
        { key: 'true' },
        { key: 'false' },
        { key: 'exit' },
        { key: 'shll' },
      ],
    },
    {
      name: 'real utilities',
      entries: [
        { key: 'echo', display: 'echo $VAR' },
        { key: 'seq' },
        { key: 'grep', display: 'grep <pattern>' },
        { key: 'sha256sum', display: 'sha256sum <text>' },
        { key: 'man', display: 'man <thing>' },
      ],
    },
  ];
  // Alias-of declarations: these COMMANDS keys render with their primary's
  // entry (vim, less, exit) and are not listed on their own — but they still
  // count as covered, so the runtime check never flags them uncategorized.
  const CHEATSHEET_ALIASES: Record<string, string> = { vi: 'vim', more: 'less', ':q': 'exit' };
  // Width budget for the ` · `-joined command lines: 74 joined chars + the
  // 2-space indent = 76 total under the session's `white-space: pre` (the
  // GREETING length precedent — longer lines clip into horizontal scroll on
  // common laptop widths). Long groups wrap to extra indented lines.
  const CHEAT_LINE_WIDTH = 74;
  const CHEAT_SEP = ' · ';

  // Shared media-query check (change o33t): the streamer's all-at-once
  // fallback, `yes`'s static variant, and the rm-deluxe wipe-skip all branch
  // on it — and the 23xc idle ghost hint now reuses it too.
  const prefersReducedMotion = (): boolean =>
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Bootstrap ──────────────────────────────────────────────────────────────
  const promptLine = document.querySelector<HTMLElement>('[data-terminal-prompt]');
  if (promptLine) initTerminal(promptLine);

  function initTerminal(promptLine: HTMLElement) {
    const session = promptLine.closest<HTMLElement>('pre.shell-session');
    if (!session) return;

    // Snapshot the already-rendered version rows from the static transcript so the
    // `version` command re-prints EXACTLY what the page shows. These rows are
    // emitted by <VersionTable/> (build-time, self-updating from help/*.json) — we
    // must NOT keep a parallel hardcoded list here or the two would drift (the page
    // self-updates; a constant wouldn't). A version row is a .shell-line carrying a
    // [git] link; we capture each row's innerHTML before the prompt is rebuilt.
    const versionRowsHtml: string[] = Array.from(
      session.querySelectorAll<HTMLElement>('span.shell-line'),
    )
      .filter((el) => /\[git\]/.test(el.textContent ?? ''))
      .map((el) => el.innerHTML);

    // ── Command history ────────────────────────────────────────────────────────
    // In-memory log of committed, non-empty, trimmed RAW lines (one history per
    // terminal instance — this lives at initTerminal scope, NOT inside freshPrompt
    // which runs per prompt). `historyCursor` is the recall position: it ranges
    // [0, history.length], where history.length is the "blank draft" slot past the
    // newest entry. ↑ walks toward 0; ↓ walks toward length (blank draft).
    //
    // Persisted in sessionStorage (NOT localStorage — a refresh keeps your recent
    // commands, but a new browser session starts clean). All storage access is
    // try/catch-guarded so private-mode / disabled-storage degrades silently to
    // in-memory-only and never throws. A malformed/non-array payload coerces to [].
    const HISTORY_KEY = 'shll:terminal:history';
    const history: string[] = loadHistory();
    let historyCursor = history.length;

    function loadHistory(): string[] {
      try {
        const parsed = JSON.parse(sessionStorage.getItem(HISTORY_KEY) ?? '[]');
        return Array.isArray(parsed) ? parsed.filter((x) => typeof x === 'string') : [];
      } catch {
        return [];
      }
    }

    function saveHistory(): void {
      try {
        sessionStorage.setItem(HISTORY_KEY, JSON.stringify(history));
      } catch {
        // sessionStorage unavailable (private mode / quota) — degrade to in-memory.
      }
    }

    // The active prompt line: replace the static "$ ▊" with a prompt + typeable
    // input region, followed by a block cursor (▊) that matches the static skin.
    // We hide the OS text-caret (caret-color: transparent in terminal.css) and
    // render our own block instead, so the prompt reads like a TTY rather than a
    // form field. The block blinks only while the input is focused.
    let input: HTMLElement;
    let cursor: HTMLElement;

    // `focus` defaults to true: after the user runs a command (Enter / clear),
    // moving focus to the next prompt is the desired terminal behavior. At initial
    // activation we pass false — auto-focusing on page load would steal focus and
    // scroll the hero out of view (discouraged; disruptive for keyboard/SR users).
    function freshPrompt(focus = true): void {
      const line = document.createElement('span');
      line.className = 'shell-line';
      line.setAttribute('data-terminal-prompt', '');

      const prompt = document.createElement('span');
      prompt.className = 'shell-prompt';
      prompt.textContent = '$';
      // Hidden from the session live region (change cuur): every fresh prompt
      // line is an appended node, so an exposed `$` would be announced after
      // every command — pure noise. The input's aria-label already carries the
      // prompt semantics; the block cursor span is aria-hidden likewise.
      prompt.setAttribute('aria-hidden', 'true');

      input = document.createElement('span');
      input.className = 'shell-input';
      // `contenteditable="true"` + an explicit plain-text paste handler (below):
      // `plaintext-only` is not consistently supported (e.g. older Firefox falls
      // back to rich contenteditable), which would let a formatted/multiline paste
      // distort the single prompt line. We normalize paste ourselves instead.
      input.setAttribute('contenteditable', 'true');
      input.setAttribute('role', 'textbox');
      input.setAttribute('aria-multiline', 'false');
      input.setAttribute('aria-label', 'Terminal command input. Type a command and press Enter. Type help to list commands.');
      input.setAttribute('spellcheck', 'false');
      input.setAttribute('autocapitalize', 'off');
      input.setAttribute('autocorrect', 'off');

      // Block cursor (▊) trailing the input — our terminal-style caret. Reuses
      // the static skin's .shell-cursor (same glyph + blink). `is-active` gates
      // the blink to focused state (set on focus, cleared on blur).
      cursor = document.createElement('span');
      cursor.className = 'shell-cursor shell-input-cursor';
      cursor.setAttribute('aria-hidden', 'true');
      cursor.textContent = '▊';

      line.appendChild(prompt);
      line.appendChild(document.createTextNode(' '));
      line.appendChild(input);
      line.appendChild(cursor);
      session!.appendChild(line);

      input.addEventListener('keydown', onKeydown);
      input.addEventListener('paste', onPaste);
      input.addEventListener('focus', onFocus);
      input.addEventListener('blur', onBlur);
      scrollToBottom();
      // Only place the caret on the focusing path: putting a selection range
      // inside a contenteditable gives it focus in Chromium, so an
      // unconditional caretToEnd() here silently violated the deliberate
      // no-autofocus-on-load decision at activation (focus = false). The
      // click-to-focus and Tab-focus paths re-place the caret themselves.
      if (focus) {
        input.focus();
        caretToEnd();
      }
    }

    function caretToEnd(): void {
      const sel = window.getSelection();
      if (!sel) return;
      const range = document.createRange();
      range.selectNodeContents(input);
      range.collapse(false);
      sel.removeAllRanges();
      sel.addRange(range);
    }

    // The session is a fixed-height scroll viewport (terminal.css). Keep the
    // newest line in view as content grows — like a real terminal scrolling up.
    function scrollToBottom(): void {
      session!.scrollTop = session!.scrollHeight;
    }

    // ── Resting-state top anchor (change 23xc) ──────────────────────────────
    // Until the first prompt-emitting interaction, the session viewport is
    // anchored so the greeting line is the FIRST visible line and the live
    // prompt sits directly below it — like a real terminal after `clear`, with
    // the boot transcript still above, reachable by scrolling up. The content
    // below the greeting (greeting + prompt, ~2 lines) is far shorter than the
    // viewport, so plain scrollTop can't reach the greeting's offset: we extend
    // the scroll range with inline bottom padding (the blank rows a real
    // terminal shows after `clear`). This is scroll GEOMETRY, not content — the
    // live prompt remains the session's last DOM child, so the exactly-one-
    // trailing-prompt invariant is untouched.
    let resting = true;

    function anchorToGreeting(greetingEl: HTMLElement): void {
      if (!greetingEl.isConnected) return;
      const style = getComputedStyle(session!);
      const padTop = parseFloat(style.paddingTop) || 0;
      // The greeting's offset from the scrollable content origin, minus the
      // normal top padding so the line rests where content normally starts.
      const target = Math.max(
        0,
        greetingEl.getBoundingClientRect().top -
          session!.getBoundingClientRect().top +
          session!.scrollTop -
          padTop,
      );
      // Extend the scroll range when the content below the greeting is shorter
      // than the viewport (always true at activation).
      const deficit = target - (session!.scrollHeight - session!.clientHeight);
      if (deficit > 0) {
        const padBottom = parseFloat(style.paddingBottom) || 0;
        session!.style.paddingBottom = `${padBottom + deficit}px`;
      }
      // Direct, instant assignment — no smooth scrolling (trivially motion-safe).
      session!.scrollTop = target;
    }

    // The first prompt-emitting interaction (Enter, Ctrl-L, Ctrl-C) ends the
    // resting state: drop the filler so the existing bottom-pinned behavior
    // (scrollToBottom after print/freshPrompt) resumes exactly as before.
    function exitResting(): void {
      if (!resting) return;
      resting = false;
      session!.style.paddingBottom = '';
    }

    // Build one transcript line element from a Line. Shared by print() and
    // printBeforePrompt() so the element shape can never drift between them
    // (extracted in change o33t — previously duplicated inline in both).
    function makeLineEl(ln: Line): HTMLElement {
      const el = document.createElement('span');
      el.className = ['shell-line', ln.classes].filter(Boolean).join(' ');
      if (ln.html) el.innerHTML = ln.text;
      else el.textContent = ln.text;
      // Live-region noise control (change o33t): lines flagged ariaHidden are
      // hidden from the cuur aria-live region — ASCII art and rapid stream
      // frames would otherwise be announced line by line.
      if (ln.ariaHidden) el.setAttribute('aria-hidden', 'true');
      return el;
    }

    // Print output lines as new spans appended to the SAME stream, reusing the
    // existing .shell-* classes. `html: true` allows handler-authored anchors
    // (e.g. man/version links) from our own trusted, static strings only.
    function print(lines: Line[]): void {
      for (const ln of lines) session!.appendChild(makeLineEl(ln));
      scrollToBottom();
    }

    // Wipe the transcript only. We do NOT emit a prompt here — onKeydown emits
    // exactly one trailing prompt after every command (including clear), so
    // emitting one here too would leave two prompts. (clear is dispatched via
    // run() inside onKeydown, before that single trailing freshPrompt().)
    function clear(): void {
      session!.replaceChildren();
    }

    // Force plain text on paste and flatten any newlines, so a multi-line or
    // formatted clipboard payload can't break the single-line prompt — robust
    // regardless of contenteditable plaintext support.
    function onPaste(e: ClipboardEvent): void {
      e.preventDefault();
      const text = (e.clipboardData?.getData('text/plain') ?? '').replace(/\r?\n/g, ' ');
      const sel = window.getSelection();
      if (!sel || !sel.rangeCount) {
        input.textContent = (input.textContent ?? '') + text;
      } else {
        const range = sel.getRangeAt(0);
        range.deleteContents();
        range.insertNode(document.createTextNode(text));
        range.collapse(false);
        sel.removeAllRanges();
        sel.addRange(range);
      }
    }

    // The block cursor blinks only while the input is focused — an unfocused
    // terminal shouldn't pulse. Toggled via an `is-active` class on the cursor.
    function onFocus(): void {
      dismissIdleHint();
      cursor?.classList.add('is-active');
    }
    function onBlur(): void {
      cursor?.classList.remove('is-active');
    }

    // ── Idle ghost hint (change 23xc) ────────────────────────────────────────
    // One-shot per page view: armed at activation, fires after HINT_DELAY_MS
    // without interaction. The ghost is VISUAL-ONLY — an aria-hidden span
    // appended to the live prompt line AFTER the block cursor (`$ ▊try 'ls' ⏎`),
    // never inside the contenteditable input: it can't be submitted by Enter,
    // is never part of the textbox's accessible name/value, and never focuses
    // the input (the deliberate no-autofocus-on-load decision stands — the
    // hint draws the eye, it does not steal focus).
    let hintTimer: number | undefined;
    let hintInterval: number | undefined;
    let hintEl: HTMLElement | undefined;
    let hintSpent = false; // one-shot latch — never re-arm after any interaction

    function armIdleHint(): void {
      hintTimer = window.setTimeout(showIdleHint, HINT_DELAY_MS);
    }

    function showIdleHint(): void {
      if (hintSpent) return;
      const liveLine = input.closest<HTMLElement>('[data-terminal-prompt]');
      if (!liveLine) return;
      hintEl = document.createElement('span');
      hintEl.className = 'shell-ghost';
      hintEl.setAttribute('aria-hidden', 'true');
      liveLine.appendChild(hintEl); // after the block cursor (line's last child)
      if (prefersReducedMotion()) {
        // Reduced motion: no typing animation — the full hint appears at once,
        // still dim, still dismissable.
        hintEl.textContent = HINT_TEXT;
        return;
      }
      // Animate the hint in character-by-character, editing the ghost span's
      // textContent in place. Deliberately NOT print()/scrollToBottom() — the
      // typing must never move the scroll position.
      let typed = 0;
      hintInterval = window.setInterval(() => {
        typed += 1;
        hintEl!.textContent = HINT_TEXT.slice(0, typed);
        if (typed >= HINT_TEXT.length) {
          window.clearInterval(hintInterval);
          hintInterval = undefined;
        }
      }, HINT_TYPE_MS);
    }

    // Any interaction spends the hint for the rest of the page view: before the
    // timer fires this cancels it; after, it removes the ghost (clearing a
    // mid-animation interval). Wired as the FIRST action of onKeydown — so e.g.
    // Tab as the first keystroke dismisses the ghost before completion logic
    // runs — plus onFocus and the terminal-surface click handler.
    function dismissIdleHint(): void {
      if (hintSpent) return;
      hintSpent = true;
      window.clearTimeout(hintTimer);
      if (hintInterval !== undefined) {
        window.clearInterval(hintInterval);
        hintInterval = undefined;
      }
      hintEl?.remove();
      hintEl = undefined;
    }

    // Freeze the live input into a static, echoed command line: strip its
    // editable attributes/listeners + the `shell-input` class so it reads like a
    // committed line, and drop its block cursor (only the live prompt carries
    // one). An optional `suffix` is appended to the echoed text — Ctrl-C uses
    // this to render the trailing `^C` a real shell prints when you abort a line.
    // Shared by the Enter branch (commit) and the Ctrl-C branch (cancel) so the
    // freeze semantics can never drift between them.
    function freezeInput(suffix = ''): void {
      input.removeAttribute('contenteditable');
      input.removeAttribute('role');
      input.removeAttribute('aria-multiline');
      input.removeAttribute('aria-label');
      input.removeEventListener('keydown', onKeydown);
      input.removeEventListener('paste', onPaste);
      input.removeEventListener('focus', onFocus);
      input.removeEventListener('blur', onBlur);
      input.classList.remove('shell-input');
      if (suffix) input.textContent = (input.textContent ?? '') + suffix;
      cursor?.remove();
    }

    function onKeydown(e: KeyboardEvent): void {
      // Any keydown is interaction: spend the idle ghost hint BEFORE branch
      // dispatch, so e.g. Tab as the very first keystroke dismisses the ghost
      // before completion logic runs (change 23xc).
      dismissIdleHint();

      // ── Control keys (Ctrl-L clear, Ctrl-C cancel) ──────────────────────────
      // Each is a prompt-emitting path OUTSIDE the Enter→run→freshPrompt flow, so
      // each must emit EXACTLY ONE trailing prompt itself (the same invariant the
      // Enter branch upholds — never two prompts, never zero). We ignore modified
      // combos (Shift/Alt/Meta) so e.g. Ctrl-Shift-C copy is left to the browser.
      if (e.ctrlKey && !e.shiftKey && !e.altKey && !e.metaKey) {
        const key = e.key.toLowerCase();
        if (key === 'l') {
          // Wipe the transcript (reusing clear()), then emit one fresh prompt.
          // clear() deliberately does NOT emit one itself, so this is exactly one.
          e.preventDefault();
          exitResting();
          // Kill any active output stream first (change o33t) — wiping the
          // screen while `yes` keeps flooding (or while the rm-deluxe beat is
          // pending) would un-clear it instantly. Matches the `clear` command,
          // which inherits the same kill via commitLine → stopStream.
          stopStream();
          clear();
          freshPrompt();
          return;
        }
        if (key === 'c') {
          // Abort the line like a real shell: freeze it with a trailing `^C`,
          // discard the typed input (do NOT run it), and drop one fresh prompt.
          // Reset the recall cursor to the blank-draft slot (as commit does), so
          // the next ↑ starts from the newest entry rather than mid-history.
          e.preventDefault();
          exitResting();
          // Also cancel any pending nav beat (change cuur): Ctrl-C inside the
          // beat window keeps you on the page — the `^C` + fresh prompt below
          // then read exactly like aborting a command in a real shell.
          if (pendingNav !== undefined) {
            window.clearTimeout(pendingNav);
            pendingNav = undefined;
          }
          // And kill any active output stream (change o33t): the frozen ^C
          // echo + fresh prompt + halted output read exactly like killing a
          // foreground process. stopStream clears the rm-deluxe followup
          // beat too, so Ctrl-C aborts that whole sequence cleanly.
          stopStream();
          freezeInput('^C');
          historyCursor = history.length;
          freshPrompt();
          return;
        }
        // Other Ctrl combos fall through to native handling.
      }

      // ── History recall (↑ back, ↓ forward) ──────────────────────────────────
      // The prompt is enforced single-line (paste flattened, aria-multiline=false),
      // so ↑/↓ unconditionally drive history rather than caret movement.
      if (e.key === 'ArrowUp') {
        e.preventDefault();
        navigateHistory(-1);
        return;
      }
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        navigateHistory(1);
        return;
      }

      // ── Tab-completion ───────────────────────────────────────────────────────
      // preventDefault FIRST — Tab's default moves focus out of the contenteditable.
      if (e.key === 'Tab') {
        e.preventDefault();
        completeInput();
        return;
      }

      if (e.key !== 'Enter') return;
      e.preventDefault();
      commitLine(true);
    }

    // ── Line commit (change by18) ────────────────────────────────────────────
    // Commit the live line exactly as Enter always did: end the resting state,
    // freeze the echoed line, record history, dispatch, and emit EXACTLY ONE
    // fresh trailing prompt. Extracted from the Enter branch (same precedent as
    // freezeInput in n23o) so the command-bar chip path commits through the
    // SAME sequence and the two can never drift — the exactly-one-trailing-
    // prompt invariant holds by construction for every committed line.
    // `focusNext` flows to freshPrompt: Enter passes true (focus follows
    // command execution — the desired keyboard behavior); the chip path passes
    // false (focusing would summon the mobile soft keyboard over the output
    // the user just asked for — a chip user is in touch mode).
    function commitLine(focusNext: boolean): void {
      // Committing is a prompt-emitting path: end the resting (top-anchored)
      // state so the bottom-pinned scroll behavior resumes for this and all
      // subsequent output (change 23xc).
      exitResting();
      const raw = (input.textContent ?? '').trim();

      // Freeze the just-entered line so it reads like a committed command line.
      freezeInput();

      if (raw === '') {
        freshPrompt(focusNext);
        return;
      }

      // Record the committed line for ↑/↓ recall. `ignoredups`: skip pushing if
      // it's identical to the immediately previous entry (bash behavior). Reset
      // the recall cursor to the blank-draft slot past the newest entry.
      if (history[history.length - 1] !== raw) {
        history.push(raw);
        saveHistory();
      }
      historyCursor = history.length;

      // A newly committed command kills any active stream (change o33t) —
      // deliberate contrast with pendingNav, which commitLine does NOT clear
      // (the nav beat is short and already announced its destination; streams
      // are long-lived and would interleave with the new command's output).
      // Placed after the empty-line short-circuit above: a bare Enter during
      // `yes` does not kill it, just like a real shell.
      stopStream();
      run(raw);
      // Emit the next prompt. If a handler navigated away (cd/open/install),
      // window.location.assign is async — this prompt is appended before unload
      // and is harmless; no guard needed.
      freshPrompt(focusNext);
    }

    // ── History navigation ──────────────────────────────────────────────────────
    // Walk the recall cursor by `dir` (-1 = ↑/back, +1 = ↓/forward), clamped to
    // [0, history.length]. The length slot is the "blank draft" position: landing
    // there restores an empty line (drafting a new command), NOT the newest entry.
    // Always leaves the caret at end via the existing caretToEnd().
    function navigateHistory(dir: -1 | 1): void {
      if (history.length === 0) return;
      const next = historyCursor + dir;
      if (next < 0 || next > history.length) return; // already at a boundary
      historyCursor = next;
      input.textContent = historyCursor === history.length ? '' : history[historyCursor];
      caretToEnd();
    }

    // ── Tab-completion ───────────────────────────────────────────────────────────
    // Complete the token under edit (bash-like). First token completes against the
    // COMMANDS keys; the second token completes against TOOLS when the first token
    // is a tool-arg command (cd/open/man). Resolution over the matching candidates:
    //   • single match    → fill it in, caret to end
    //   • longest common   → fill the shared prefix (partial completion), no listing
    //     prefix > typed
    //   • multiple matches → print the candidates as one space-joined shell-out line
    //     (no LCP gain)       ABOVE the still-live input, WITHOUT freezing it or
    //                         emitting a new prompt (input + caret stay untouched)
    //   • no match         → no-op (input unchanged, nothing printed)
    const TOOL_ARG_COMMANDS = ['cd', 'open', 'man'];

    function completeInput(): void {
      const raw = input.textContent ?? '';
      // Tokenize on whitespace; a trailing space means we're completing a fresh
      // (empty) next token, so reflect that in the parts list.
      const parts = raw.split(/\s+/);
      const tokenIndex = parts.length - 1;
      const fragment = parts[tokenIndex];

      let candidates: readonly string[];
      if (tokenIndex === 0) {
        candidates = Object.keys(COMMANDS);
      } else if (tokenIndex === 1 && TOOL_ARG_COMMANDS.includes(parts[0].toLowerCase())) {
        candidates = TOOLS;
      } else {
        return; // nothing to complete beyond the supported positions
      }

      const matches = candidates.filter((c) => c.startsWith(fragment));
      if (matches.length === 0) return; // no match → no-op

      if (matches.length === 1) {
        fillToken(parts, tokenIndex, matches[0]);
        return;
      }

      // Multiple matches: extend to the longest common prefix if it's longer than
      // what's typed (first-Tab partial completion). Otherwise list the candidates.
      const lcp = longestCommonPrefix(matches);
      if (lcp.length > fragment.length) {
        fillToken(parts, tokenIndex, lcp);
        return;
      }
      // Ambiguous at the typed prefix — list candidates above the live input. No
      // freeze, no freshPrompt(): the input span keeps its text and caret, so the
      // "exactly one trailing prompt" invariant is untouched (nothing is committed).
      // We must NOT use print() here: print() appends to the end of `session`, which
      // would drop the listing BELOW the live prompt (the current last line), leaving
      // the prompt no longer trailing — un-shell-like and contrary to the invariant.
      // Instead insert the listing immediately BEFORE the live prompt line so the
      // prompt stays the last line, exactly as a real shell redraws it.
      printBeforePrompt({ text: matches.join('  '), classes: 'shell-out' });
    }

    // Insert a single output line directly BEFORE the live prompt line, so the
    // prompt remains the trailing element. Used by the Tab ambiguous-match listing,
    // which prints above a still-live (uncommitted) prompt — unlike print(), which
    // appends after the (already-frozen) command line for normal command output.
    function printBeforePrompt(ln: Line): void {
      const el = makeLineEl(ln);
      // The live prompt line is `input`'s parent span ([data-terminal-prompt]); it is
      // the last child of `session` while the prompt is live. Insert the listing just
      // before it. insertBefore(el, null) appends to the end, so a detached/missing
      // prompt line degrades to print()'s append behavior rather than throwing.
      // The isContentEditable gate (change o33t): during run() the previous
      // input is already frozen — but freezeInput leaves a stale
      // data-terminal-prompt attribute on the frozen line, so a bare closest()
      // lookup would insert ABOVE the just-echoed command. With no LIVE prompt
      // (reduced-motion streams print synchronously inside run()), fall back
      // to appending — exactly where print() would land the line.
      const liveLine = input.isContentEditable
        ? input.closest<HTMLElement>('[data-terminal-prompt]')
        : null;
      session!.insertBefore(el, liveLine);
      // While resting (top-anchored, change 23xc), pinning to bottom would jump
      // the viewport into the blank filler padding and defeat the greeting
      // anchor. The listing lands just below the still-anchored greeting — in
      // the already-visible region — so preserve the scroll position instead.
      if (!resting) scrollToBottom();
    }

    // Replace the token at `tokenIndex` with `value`, rejoining the line, then put
    // the caret at end. For a first-token completion this is the whole input; for a
    // second-token completion the leading command prefix (cd/open/man) is preserved.
    function fillToken(parts: string[], tokenIndex: number, value: string): void {
      const next = parts.slice();
      next[tokenIndex] = value;
      input.textContent = next.join(' ');
      caretToEnd();
    }

    function longestCommonPrefix(strings: readonly string[]): string {
      if (strings.length === 0) return '';
      let prefix = strings[0];
      for (const s of strings) {
        while (!s.startsWith(prefix)) {
          prefix = prefix.slice(0, -1);
          if (prefix === '') return '';
        }
      }
      return prefix;
    }

    function run(raw: string): void {
      const parts = raw.split(/\s+/);
      let name = parts[0].toLowerCase();
      let args = parts.slice(1);

      // `shll version` is an alias for `version`.
      if (name === 'shll' && args[0]?.toLowerCase() === 'version') {
        name = 'version';
        args = args.slice(1);
      }

      const ctx: Ctx = { print, clear, raw: args.join(' ') };
      // Own-property guard (change o33t review rework): COMMANDS is a plain
      // object literal, so an unguarded lookup walks the prototype chain —
      // a bare `__proto__` resolved to Object.prototype (truthy, not a
      // Handler) and "calling" it threw before freshPrompt could emit the
      // next prompt. Inherited names must dispatch to command-not-found.
      const handler = Object.hasOwn(COMMANDS, name) ? COMMANDS[name] : undefined;
      if (handler) {
        const out = handler(args, ctx);
        if (out) print(out);
      } else {
        // Did-you-mean (change cuur): a small edit-distance match over the
        // COMMANDS keys — hidden eggs included as candidates (a near-miss egg
        // rewards the curiosity the help footer invites; the list itself still
        // never reveals them). A suggestion replaces the `type 'help'` tail on
        // the same line; with no candidate within threshold (max distance 1
        // for inputs ≤3 chars, else 2) the existing line is unchanged.
        const suggestion = suggestCommand(name, Object.keys(COMMANDS));
        const tail = suggestion ? `did you mean '${suggestion}'?` : "type 'help'";
        print([{ text: `command not found: ${parts[0]} — ${tail}`, classes: 'shell-out' }]);
      }
    }

    // ── Command dispatch map ──────────────────────────────────────────────────
    const COMMANDS: Record<string, Handler> = {
      // Bare `help` prints the short list, UNCHANGED by change cuur — detail
      // lives behind `help <command>` (the helpFor helper below), so the list
      // can stay scannable without losing depth. Eggs stay unlisted.
      help(args) {
        if (args[0]) return helpFor(args[0].toLowerCase());
        return [
          { text: 'available commands:', classes: 'shell-out' },
          { text: '  help            list these commands', classes: 'shell-out' },
          { text: '  ls              list the 7 tools', classes: 'shell-out' },
          { text: '  cd <tool>       open a tool overview  (alias: open)', classes: 'shell-out' },
          { text: '  install         go to the install guide', classes: 'shell-out' },
          { text: '  version         print tool versions', classes: 'shell-out' },
          { text: '  theme [dark|light]   switch the color theme', classes: 'shell-out' },
          { text: '  echo <text>     print text', classes: 'shell-out' },
          { text: '  man <tool>      one-line synopsis of a tool', classes: 'shell-out' },
          { text: '  whoami          who are you, really', classes: 'shell-out' },
          { text: '  fortune         a dev aphorism', classes: 'shell-out' },
          { text: '  history         list previously entered commands', classes: 'shell-out' },
          { text: '  clear           clear the screen', classes: 'shell-out' },
          { text: '', classes: 'shell-out' },
          // The one sanctioned change to bare `help` (change cdbr): keep the
          // curiosity tease, append the cheatsheet pointer. The curated list
          // above stays byte-identical — cheatsheet is the reveal, not a
          // listed utility; this tip (and guessing) is its discovery path.
          { text: "tip: a few commands aren't on this list. a curious dev might try the obvious ones — or type 'cheatsheet' for everything.", classes: 'shell-comment' },
        ];
      },

      ls() {
        const links = TOOLS.map(
          (t) => `<a href="${ROUTE_OVERVIEW(t)}">${t}</a>`,
        ).join('  ');
        return [{ text: links, classes: 'shell-out', html: true }];
      },

      cd(args) {
        return navigateTool(args[0]);
      },
      open(args) {
        return navigateTool(args[0]);
      },

      install() {
        // Same nav beat as cd/open (change cuur) — install keeps its single
        // `opening …` line, now a clickable anchor with the cancel hint. The
        // install chip (change by18) commits through commitLine → run → here,
        // so touch users inherit the beat and the tappable link too.
        return navigateWithBeat(ROUTE_INSTALL, []);
      },

      version() {
        // Re-print the rows captured from the static <VersionTable/> output — the
        // single source of truth (build-time, self-updating from help/*.json). No
        // hardcoded list here, so the terminal and the page can never drift, and a
        // version bump or roster/label change (e.g. run-kit → "rk") flows through
        // automatically. The captured innerHTML already carries the tool/version/
        // [git] markup; `print()` adds the base `shell-line` class.
        if (versionRowsHtml.length === 0) {
          return [{ text: 'version: no data', classes: 'shell-out shell-dim' }];
        }
        return versionRowsHtml.map((html) => ({ text: html, html: true }));
      },

      theme(args) {
        return setTheme(args[0]);
      },

      // List previously entered commands. Reads the SAME `history` array the ↑/↓
      // recall walks, so the two can never disagree. One indexed (1-based) line
      // each, `shell-out` class — matching the rest of the command output skin.
      history() {
        if (history.length === 0) {
          return [{ text: 'no history yet', classes: 'shell-out shell-dim' }];
        }
        return history.map((cmd, i) => ({
          text: `  ${String(i + 1).padStart(3)}  ${cmd}`,
          classes: 'shell-out',
        }));
      },

      clear(_args, ctx) {
        ctx.clear();
      },

      // ── Easter eggs ──────────────────────────────────────────────────────────
      whoami() {
        return [
          { text: 'a developer who plans before they code.', classes: 'shell-out' },
          { text: '(everyone else is just typing.)', classes: 'shell-comment' },
        ];
      },

      sudo(args) {
        const what = args.join(' ').trim();
        return [
          { text: what ? `nice try. you are not in the sudoers file.` : 'sudo: a password is required (and you don’t have one here).', classes: 'shell-out' },
          { text: 'this incident will be planned, not reported.', classes: 'shell-comment' },
        ];
      },

      echo(_args, ctx) {
