        const pattern = ctx.raw.trim();
        if (!pattern) {
          return [
            { text: 'usage: grep <pattern>', classes: 'shell-out' },
            { text: "(searches the seven tools' synopses.)", classes: 'shell-out shell-dim' },
          ];
        }
        const needle = pattern.toLowerCase();
        const hits = TOOLS.filter((t) => `${t} — ${SYNOPSIS[t]}`.toLowerCase().includes(needle));
        if (hits.length === 0) {
