---
/**
 * InstallOneLiner — the per-tool one-step install one-liner for tool overviews.
 *
 * Renders the toolkit's real one-step installer scoped to a single tool as an
 * Expressive Code terminal block:
 *
 *     curl -fsSL https://shll.ai/install | sh -s -- <tool>
 *
 * plus one short site-authored sentence pointing at the whole-toolkit story.
 * The `shll.ai/install` script (PR #84) accepts a tool subset via `sh -s --`,
 * so this line is accurate and copy-pasteable per tool.
 *
 * COPY BUTTON PARITY: the block is rendered via Starlight's re-exported
 * Expressive Code `<Code>` component — the same engine behind every fenced
 * code block on the site (getting-started/install, the commands/readme pages)
 * — so it carries the identical terminal frame styling (astro.config.mjs
 * expressiveCode styleOverrides) AND the one-click copy button. This replaced
 * the original hand-rolled `.shell-session` markup, whose only copy affordance
 * was text selection. The copy button's tiny script is EC's own, already
 * shipped by every page with a fenced block — no new dependency (the import
 * is a Starlight re-export, Constitution VI) and no new JS mechanism
 * (Constitution I's build-time discipline: the block is fully rendered at
 * build; EC's copy script is progressive enhancement the site already carries).
 *
 * SHLL IS SPECIAL: `shll` is the bootstrap meta-CLI, not a roster install
 * target — the script execs `shll install "$@"`, and `shll install shll` hard-
 * errors (shll isn't one of the six installable tools; see getting-started/
 * install and help/shll.json). For `tool === 'shll'` we render the whole-toolkit
 * one-liner `curl -fsSL https://shll.ai/install | sh` (no `sh -s -- shll`),
 * which is exactly the bootstrap the homepage/install page document.
 *
 * SINGLE SOURCE: this component is the sole carrier of the per-tool one-liner.
 * It deliberately does NOT add seven hand-copied install blocks. The two
 * documented hand-copy surfaces — the homepage install block (index.mdx) and
 * getting-started/install.md — stay the canonical hand-written carriers of the
 * whole-toolkit quick-start and are untouched by this component.
 *
 * WHY AN .astro COMPONENT (not inline MDX): the command contains both `--` and
 * a bare URL. MDX runs remark plugins over JSX text — smartypants turns `--`
 * into an em-dash and bare URLs get auto-linked — so an inline MDX block would
 * mangle the copied command (see the remark-hazard note in index.mdx). Here the
 * command is built as a plain JS string and handed to `<Code>` as a prop, so
 * the literal `sh -s -- <tool>` and the URL survive verbatim — in the render
 * AND in what the copy button copies.
 *
 * The note's colors come from the site's --c-* tokens (src/styles/terminal.css),
 * and the EC frame colors are token-driven via astro.config.mjs, so dark-mode
 * parity is automatic (Constitution V).
 *
 * Placement convention: an `## Install` section between the overview's lead and
 * `## How it fits`. See docs/memory/conventions/tool-page-rubric.
 */
import { Code } from '@astrojs/starlight/components';
import { isToolSlug } from '../lib/tool-slugs.ts';

interface Props {
  /** Tool slug — the install subset passed to `sh -s -- <tool>`. */
  tool: string;
}

const { tool } = Astro.props as Props;

// A missing slug is a page-author error (the prop was forgotten) — fail the
// build loudly rather than emitting a broken `sh -s -- ` line, mirroring
// GithubButton's and CommandReference's top-level guards.
if (!tool) {
  throw new Error('InstallOneLiner: a `tool` slug prop is required.');
}

// An unknown slug would emit an install command for a tool that does not exist
// in the roster — a defect that must not deploy. Gate on the shared roster
// (the same isToolSlug gate every root-namespace dispatcher uses, change 3ke3).
if (!isToolSlug(tool)) {
  throw new Error(
    `InstallOneLiner: unknown tool slug \`${tool}\` — not one of the roster in src/lib/tool-slugs.ts.`,
  );
}

// `shll` bootstraps the whole toolkit — it is NOT a `shll install` target, so
// `sh -s -- shll` would hard-error. Render the whole-toolkit bootstrap instead.
const isShll = tool === 'shll';

// The one-liner is built here (not in markdown) so the `--` and the URL
// never pass through any markdown/remark transform.
const oneLiner = isShll
  ? `curl -fsSL https://shll.ai/install | sh`
  : `curl -fsSL https://shll.ai/install | sh -s -- ${tool}`;

// Whole-toolkit follow-on steps (isShll only). Most visitors copy the homepage
// one-liner and assume they're done — surfacing the post-install steps right
// under it keeps them from being missed. Wording mirrors the canonical block in
// getting-started/install.md (the sole hand-written carrier of the full steps).
const followOn = [
  'shll shell-setup      # wire your shell integration',
  'run-kit agent-setup   # optional, once per machine',
  'exec $SHELL           # reload your shell',
].join('\n');
---

<div class="install-one-liner not-content">
  <Code code={oneLiner} lang="bash" />
  {isShll ? (
    <>
      <p class="install-one-liner-note">then wire your shell:</p>
      <Code code={followOn} lang="bash" />
      <p class="install-one-liner-note">
        Installs <code>shll</code> and the whole toolkit via Homebrew — see the <a
          href="/getting-started/install/">full install guide</a>.
      </p>
    </>
  ) : (
    <p class="install-one-liner-note">
      Installs <code>shll</code> + <code>{tool}</code> via Homebrew — or <a
        href="/getting-started/install/">install the whole toolkit</a>.
    </p>
  )}
</div>

<style>
  /* The command block is Expressive Code (frame styling + copy button from the
     site-wide EC config in astro.config.mjs) — no terminal styling is
     duplicated here. The note's link styling also lives in terminal.css:
     change ld0j keeps every terminal-styled link in ONE selector group
     (.shell-session a, .home-prose a, .tools-listing a,
     .install-one-liner-note a) — one source, no per-class copies — so no link
     rules are duplicated here either. This scoped block is layout/typography
     only. */
  .install-one-liner {
    margin: 0.75rem 0 1.25rem;
  }
  .install-one-liner-note {
    margin: 0.65rem 0 0;
    font-family: var(--sl-font-mono);
    font-size: 0.85rem;
    color: var(--c-fg-dim);
  }
  .install-one-liner-note code {
    color: var(--c-fg);
  }
</style>
