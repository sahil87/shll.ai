---
/**
 * ReadmeMobileToc — README-page counterpart to CommandsMobileToc, overriding
 * Starlight's MOBILE "On this page" dropdown. On per-tool `readme` pages it lists
 * the slice's nested H2 → H3 headings in the mobile dropdown; on every other page
 * it falls through to Starlight's default (route gating lives in
 * MobileTocDispatcher; this is only rendered on readme routes).
 *
 * Mirrors the default's `<mobile-starlight-toc>` dropdown frame (fixed bar +
 * <details> dropdown) — and CommandsMobileToc's framing — so the look matches,
 * but renders our heading links and a self-contained open/close + jump script.
 * Build-time only (Constitution I); the nested list read from
 * `content/<tool>/README.md` via the shared lib/readme-toc helper.
 */
import { Icon } from '@astrojs/starlight/components';
import Default from '@astrojs/starlight/components/MobileTableOfContents.astro';
import { readmeToc, toolFromReadmeRouteId } from '../lib/readme-toc.ts';

const tool = toolFromReadmeRouteId(Astro.locals.starlightRoute.id);
const headings = tool ? await readmeToc(tool, import.meta.url) : [];
const useCustom = headings.length > 0;
const onThisPage = Astro.locals.t('tableOfContents.onThisPage');
---

{
  useCustom ? (
    <readme-mobile-toc>
      <nav aria-labelledby="starlight__on-this-page--mobile">
        <details id="starlight__mobile-toc">
          <summary id="starlight__on-this-page--mobile" class="sl-flex">
            <span class="toggle sl-flex">
              {onThisPage}
              <Icon name="right-caret" class="caret" size="1rem" />
            </span>
            <span class="display-current" />
          </summary>
          <div class="dropdown">
            <ul class="readme-mtoc-list">
              {headings.map((h) => (
                <li>
                  <a href={`#${h.slug}`} data-readme-toc-link={h.slug}>
                    {h.text}
                  </a>
                  {h.children.length > 0 && (
                    <ul class="readme-mtoc-sublist">
                      {h.children.map((c) => (
                        <li>
                          <a href={`#${c.slug}`} data-readme-toc-link={c.slug}>
                            {c.text}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </details>
      </nav>
    </readme-mobile-toc>
  ) : (
    <Default />
  )
}

<style>
  /* Mirror the default mobile ToC frame (fixed bar + dropdown) so the look
     matches; only the list inside differs. Kept in lockstep with
     CommandsMobileToc's frame. */
  @layer starlight.core {
    nav {
      position: fixed;
      z-index: var(--sl-z-index-toc);
      top: calc(var(--sl-nav-height) - 1px);
      inset-inline: 0;
      border-top: 1px solid var(--sl-color-gray-5);
      background-color: var(--sl-color-bg-nav);
    }
    @media (min-width: 50rem) {
      nav {
        inset-inline-start: var(--sl-content-inline-start, 0);
      }
    }
    summary {
      gap: 0.5rem;
      align-items: center;
      height: var(--sl-mobile-toc-height);
      border-bottom: 1px solid var(--sl-color-hairline-shade);
      padding: 0.5rem 1rem;
      font-size: var(--sl-text-xs);
      outline-offset: var(--sl-outline-offset-inside);
    }
    summary::marker,
    summary::-webkit-details-marker {
      display: none;
    }
    .toggle {
      flex-shrink: 0;
      gap: 1rem;
      align-items: center;
      justify-content: space-between;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 0.5rem;
      padding-block: 0.5rem;
      padding-inline-start: 0.75rem;
      padding-inline-end: 0.5rem;
      line-height: 1;
      background-color: var(--sl-color-black);
      user-select: none;
      cursor: pointer;
    }
    details[open] .toggle {
      color: var(--sl-color-white);
      border-color: var(--sl-color-accent);
    }
    details .toggle:hover {
      color: var(--sl-color-white);
      border-color: var(--sl-color-gray-2);
    }
    :global([dir='rtl']) .caret {
      transform: rotateZ(180deg);
    }
    details[open] .caret {
      transform: rotateZ(90deg);
    }
    .display-current {
      white-space: nowrap;
      text-overflow: ellipsis;
      overflow: hidden;
      color: var(--sl-color-white);
    }
    .dropdown {
      --border-top: 1px;
      margin-top: calc(-1 * var(--border-top));
      border: var(--border-top) solid var(--sl-color-gray-6);
      border-top-color: var(--sl-color-hairline-shade);
      max-height: calc(85vh - var(--sl-nav-height) - var(--sl-mobile-toc-height));
      overflow-y: auto;
      background-color: var(--sl-color-black);
      box-shadow: var(--sl-shadow-md);
      overscroll-behavior: contain;
    }
    .readme-mtoc-list,
    .readme-mtoc-sublist {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .readme-mtoc-list {
      padding: 0.5rem 0;
    }
    .readme-mtoc-list a {
      display: block;
      font-size: var(--sl-text-xs);
      padding: 0.4rem 1rem;
      color: var(--sl-color-gray-2);
    }
    .readme-mtoc-list a:hover {
      color: var(--sl-color-white);
    }
    /* Indent the nested H3 child links so the dropdown reads as a hierarchy. */
    .readme-mtoc-sublist a {
      padding-inline-start: 2rem;
      color: var(--sl-color-gray-3);
    }
  }
</style>

<script>
  // Progressive enhancement only (Constitution I). Close the dropdown after
  // navigating, reflect the chosen heading in the collapsed bar, and close on
  // outside-click / Escape — matching the default mobile ToC's affordances.
  // Targets are real headings, so (unlike CommandsMobileToc) there is no
  // <details> to expand on click.
  class ReadmeMobileToc extends HTMLElement {
    connectedCallback() {
      const details = this.querySelector('details');
      if (!details) return;
      const close = () => {
        details.open = false;
      };
      // The collapsed bar shows the current heading (like the default mobile
      // ToC). Initialize to the first entry; update it when one is chosen.
      const display = this.querySelector<HTMLElement>('.display-current');
      const links = Array.from(
        this.querySelectorAll<HTMLAnchorElement>('a[data-readme-toc-link]'),
      );
      if (display && links.length > 0) {
        display.textContent = links[0].textContent?.trim() ?? '';
      }
      links.forEach((a) => {
        a.addEventListener('click', () => {
          if (display) display.textContent = a.textContent?.trim() ?? '';
          close();
        });
      });
      window.addEventListener('click', (e) => {
        if (!details.contains(e.target as Node)) close();
      });
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && details.open) {
          const hadFocus = details.contains(document.activeElement);
          close();
          if (hadFocus) this.querySelector('summary')?.focus();
        }
      });
    }
  }
  if (!customElements.get('readme-mobile-toc')) {
    customElements.define('readme-mobile-toc', ReadmeMobileToc);
  }
</script>
