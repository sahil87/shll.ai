---
/**
 * GithubButton — a small, labeled "go to the repo" affordance for tool pages.
 *
 * Renders a build-time anchor to `https://github.com/sahil87/<tool>` (no
 * client-side JS — Constitution I). Colors come from the site's --c-* tokens
 * (src/styles/terminal.css), which flip with Starlight's data-theme, so dark-
 * mode parity is automatic (Constitution V). A visible :focus-visible ring
 * keeps it keyboard-navigable (Constitution Accessibility).
 *
 * Placement convention: rendered near the top of every tool overview page,
 * just under the H1. See docs/memory/conventions/tool-page-rubric.
 *
 * Star count (change d9qb): the row shows the repo's star count as build-time
 * social proof — fetched once per repo per build (src/lib/github-stars.ts),
 * rendered statically (Constitution I), at most ~24h stale via the daily
 * scheduled pulls (the help refresh's captured_at churn commits daily — see
 * github-stars.ts). FAIL-SOFT: on any fetch failure the count is null and
 * the button renders exactly as before this change — count omitted, no
 * placeholder, never a failed build.
 */
import { getStarCount, formatStarCount } from '../lib/github-stars.ts';

interface Props {
  /** Tool slug — names the repo at `github.com/sahil87/<tool>`. */
  tool: string;
}

const { tool } = Astro.props as Props;

// A missing slug is a page-author error (the prop was forgotten) — fail the
// build loudly rather than silently linking to a broken `sahil87/` URL,
// mirroring CommandReference's top-level guard.
if (!tool) {
  throw new Error('GithubButton: a `tool` slug prop is required.');
}

const href = `https://github.com/sahil87/${tool}`;
const stars = await getStarCount(tool);
---

<div class="gh-button not-content">
  <a class="gh-link" href={href}>
    <span class="gh-label">View on GitHub</span>
    <span class="gh-slug">github.com/sahil87/{tool}</span>
    {
      /* Rendered ONLY with a real count — null omits the span entirely (no
         placeholder), keeping the no-count markup identical to pre-d9qb. The
         glyph is decorative (aria-hidden); the sr-only text gives screen
         readers "N GitHub stars" instead of a bare "star one-point-two-k". */
      stars !== null && (
        <span class="gh-stars">
          <span class="gh-star-glyph" aria-hidden="true">★</span>
          {formatStarCount(stars)}<span class="sr-only"> GitHub stars</span>
        </span>
      )
    }
    <span class="gh-arrow" aria-hidden="true">↗</span>
  </a>
</div>

<style>
  .gh-button {
    margin: 0.75rem 0 1.25rem;
    font-family: var(--sl-font-mono);
    font-size: 0.85rem;
  }

  .gh-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.4rem 0.75rem;
    color: var(--c-fg);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: 4px;
    text-decoration: none;
    transition:
      border-color 0.12s ease,
      background 0.12s ease;
  }
  .gh-link:hover {
    border-color: var(--c-accent);
    background: var(--c-surface-2);
  }
  /* Visible focus state for keyboard users (Constitution Accessibility). */
  .gh-link:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 2px;
  }

  .gh-label {
    color: var(--c-fg);
    font-weight: 600;
  }
  .gh-slug {
    color: var(--c-fg-dim);
  }
  /* Star count (change d9qb) — dim like the slug (it is metadata, not the
     action), with the glyph in the accent like the arrow. Both colors are
     --c-* tokens, so dark-mode parity is automatic (Constitution V). */
  .gh-stars {
    color: var(--c-fg-dim);
  }
  .gh-star-glyph {
    color: var(--c-accent);
  }
  /* Screen-reader-only label for the count (the CommandReference idiom). */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .gh-arrow {
    color: var(--c-accent);
    font-weight: 600;
  }

  .gh-link ::selection {
    background: var(--c-fg);
    color: var(--c-bg);
  }
</style>
