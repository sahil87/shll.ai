# build output
dist/
# generated types
.astro/
# fetched at deploy time from sahil87/shll scripts/install.sh (served at shll.ai/install)
sites/*/public/install

# dependencies
node_modules/

# test scratch (belt-and-suspenders: the docs/site CLI mirror test writes to the
# real repo root under a throwaway slug + a .test-tmp/ dir, cleaned by t.after;
# ignore them so a hard crash mid-test can't strand them next to real content)
/.test-tmp/
/content/__*test*__/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

.fab-*

/.agents

/.claude

/.cursor

/.opencode

/.codex

/.gemini

.uploads/

.status.yaml.lock

!fab/.fab-version

/.kimi
